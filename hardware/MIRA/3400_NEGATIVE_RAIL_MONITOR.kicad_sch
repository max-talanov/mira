	(text "Negative rail voltage and current monitor"
		(exclude_from_sim no)
		(at 156.21 26.24 0)
		(effects
			(font
				(size 2.05 2.05)
				(thickness 0.18)
				(bold yes)
				(color 25 47 72 1)
			)
			(justify left top)
		)
		(uuid "26697512-ba32-4481-b760-399f56985b23")
	)
	(text "N15_RAW is the converter output before the 0.1 Ohm shunt R1107.\nN15 is the delivered rail after that shunt. U3401 uses AON and\nN15_RAW as its supply rails. Channel A measures the shunt drop;\nchannel B scales N15. The outputs are referenced to system GND."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "4d1a626b-a22b-4606-84d0-38ce04a9669b")
	)
	(text "Inputs and outputs"
		(exclude_from_sim no)
		(at 156.21 63.5 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "5372fae1-64da-465b-8a73-72921c289d59")
	)
	(text "Purpose and role"
		(exclude_from_sim no)
		(at 156.21 40.64 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "5acf6604-b011-4d58-b70b-8d26d2477a8b")
	)
	(text "Negative voltage scaling\nMON_V_N15 = -0.1 x N15; -15 V gives +1.50 V.\nThis measures rail voltage, not programming pulses."
		(exclude_from_sim no)
		(at 21.59 145 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "60c44131-052c-44d6-a65f-59ce11fe60e0")
	)
	(text "Control logic"
		(exclude_from_sim no)
		(at 156.21 86.36 0)
		(effects
