	(text "R1105/R1106 set -14.99 V at N15_RAW.\nR1107 reduces the magnitude by 100 mV/A."
		(exclude_from_sim no)
		(at 23 104.7 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
