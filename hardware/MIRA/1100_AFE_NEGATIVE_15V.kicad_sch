				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "1c4e144b-3bbc-4eca-8935-73d78f05fe19")
	)
	(text "U1102 (LMR51610XFDBVR) uses forced PWM at 400 kHz. L1101 returns to system\nGND. C1101 connects CB to SW. C1102/C1103 bypass BUS24 to GND; C1104/C1105\nbypass BUS24 to N15_RAW. C1106-C1109 filter the negative output."
		(exclude_from_sim no)
		(at 156.21 90.5 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "345a4834-05f5-4628-b4a5-bc55047ad0b3")
	)
	(text "Conversion and filtering"
		(exclude_from_sim no)
		(at 156.21 85.7 0)
		(effects
			(font
				(size 1.9 1.9)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "451d9f82-80ea-4b47-990a-426b25a48dcc")
	)
	(text "U1102 GND = N15_RAW, not system GND."
		(exclude_from_sim no)
		(at 23 65.7 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
