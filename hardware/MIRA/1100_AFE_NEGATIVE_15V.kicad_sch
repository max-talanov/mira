				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "1bfbbe10-6690-4cf4-9756-1df239991056")
	)
	(text "Output voltage setting"
		(exclude_from_sim no)
		(at 156.21 111.2 0)
		(effects
