	(text "Generates N15 from BUS24 using an inverting buck-boost connection. The\nnominal pre-shunt output is -14.99 V relative to system GND. U1102 local GND\nis N15_RAW, not system GND."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "08d77e88-6998-4532-b5c9-cecf63bd1baf")
	)
	(text "1100_AFE_NEGATIVE_15V"
		(exclude_from_sim no)
		(at 20.32 19.05 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "0d95f988-b52c-4640-9a69-451916cd258e")
	)
	(text "R1105 (22.1 kOhm) is FB-to-N15_RAW; R1106 (392 kOhm) is FB-to-system-GND.\n|VRAW| = 0.8 V x (1 + R1106/R1105) = 14.99 V.\nTo change magnitude: R1106 = R1105 x (|VRAW|/0.8 V - 1). Increasing R1106\nmakes the rail more negative."
		(exclude_from_sim no)
		(at 156.21 116 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "182c69b8-1342-4e55-9d87-ba50b7efdfdb")
	)
	(text "Input and enable"
		(exclude_from_sim no)
		(at 156.21 60.5 0)
		(effects
