		(uuid "d7199f7e-0014-4051-a069-84df9f4987ed")
	)
	(text "SHEET GUIDE / 1100_AFE_NEGATIVE_15V"
		(exclude_from_sim no)
		(at 156.21 19.24 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "d94f0e71-2d60-422a-a20e-277290d69cea")
	)
	(text "R1107 (0.1 Ohm) reduces |N15| by 100 mV/A. R1108 bleeds the rail; D1101\nclamps positive excursions of N15_RAW. Inverting operation has less\noutput-current capability than the 1 A buck rating; TI gives about 0.56 A at\n24 V/-15 V, assuming 80% efficiency. Verify the intended load."
		(exclude_from_sim no)
		(at 156.21 141 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "dd102a44-3330-4a5f-8035-8a081c658614")
	)
