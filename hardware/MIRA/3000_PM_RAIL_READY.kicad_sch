	)
	(text "Any included status going LOW deasserts ALL_RAILS_PG and removes one condition\nfor matrix operation. The permit and fault-memory circuitry determines shutdown\nbehavior. Intentionally disabling any included supply also removes readiness;\nthis tree provides no per-rail bypass."
		(exclude_from_sim no)
		(at 156.21 136.88 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "38ff88bf-8298-437e-9d26-e94d42df4578")
	)
	(text "The tree receives PG_USB, PG_SYS, PG_FPGA, PG_ANA, PG_P15, PG_N15 and nine PGR\nsignals for the secondary rails. ALL_RAILS_PG is an active-high, push-pull\noutput. All three SN74HCS21 devices use AON; C3001, C3002 and C3003 provide 100\nnF bypassing."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "556c47d1-bebb-4ec5-9f29-16a090db5d4f")
	)
