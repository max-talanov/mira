	)
	(text "Combined rail power-good logic"
		(exclude_from_sim no)
		(at 156.21 26.24 0)
		(effects
			(font
				(size 2.05 2.05)
				(thickness 0.18)
				(bold yes)
				(color 25 47 72 1)
			)
			(justify left top)
		)
		(uuid "e1a4a35b-87b0-4a4b-b957-8ec3033f2600")
	)
	(text "U3001 combines USB/SYS/FPGA/ANA and P15/N15/CORE/AUX18. U3002 combines\nAUX25/IO33/DDR/PHY and VTT/ANA5/ANA33. AON fixes the fourth input of the last\ngroup HIGH. U3003 ANDs PG_GROUP_0-PG_GROUP_3; every one of the fifteen status\ninputs must be HIGH."
		(exclude_from_sim no)
		(at 156.21 91.16 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "f50dbe3d-ca0d-4d33-9f0e-46883359d146")
	)
	(text "This block combines MIRA's measured rail status into ALL_RAILS_PG. It tells the\npower controller, matrix interlock and host interface that every included supply\nreports ready. It works with the separate command aggregate so an enable request\nalone cannot establish supply readiness."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "fd989a5a-794f-4e5d-ba66-b0e3241707a9")
	)
