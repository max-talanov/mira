	(text "SHEET GUIDE / 3200_PM_NEGATIVE_OVERCURRENT"
		(exclude_from_sim no)
		(at 156.21 19.24 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "1d19f07f-f65b-4da8-af54-1b10f42f0689")
	)
	(text "Control logic"
		(exclude_from_sim no)
		(at 156.21 86.36 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "2612fd68-7b45-4a8f-be28-58bc8cebdda8")
	)
	(text "Negative rail overcurrent comparator"
		(exclude_from_sim no)
		(at 156.21 26.24 0)
		(effects
			(font
				(size 2.05 2.05)
				(thickness 0.18)
				(bold yes)
				(color 25 47 72 1)
			)
			(justify left top)
		)
		(uuid "281e7967-2bb5-4264-b149-8f8c6b107bfd")
	)
	(text "U3201 is powered from AON. OC_I_N15 must be a conditioned,\npositive current-sense voltage within the AON input range.\nOC_OK_N feeds the permit interlock and the power controller."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "2bbff7e5-cbaf-4695-9930-5a27713a1f87")
	)
	(text "Threshold reference\nVREF = AON x 10 / 57"
		(exclude_from_sim no)
		(at 22.86 39.37 0)
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "2cc01292-af01-4d37-8ff9-4f3aa4cd5b8e")
	)
	(text "A LOW OC_OK_N clears the power latch through the interlock sheet.\nThe current-sense source is absent from the supplied files; recover\nit before relying on this protection. The comparator alone does\nnot establish a validated trip current or complete shutdown time."
		(exclude_from_sim no)
		(at 156.21 136.88 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "2d21f59b-0e8b-4431-8309-6f5c99458643")
	)
	(text "Timing and settings"
		(exclude_from_sim no)
		(at 156.21 109.22 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "429337fe-2158-433e-a113-cc8cdb6c0cd6")
	)
	(text "R3201 / R3202 set VREF = AON x 10 / 57, about 0.575 V at 3.28 V.\nC3201 filters this reference with an 82 us time constant.\nThe current limit also depends on the external sense gain and shunt.\nThis circuit has no intentional hysteresis or local sense filtering."
		(exclude_from_sim no)
		(at 156.21 114.02 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "4421ad2d-ecf6-4efb-a2f9-9bbf5434d167")
	)
	(text "Current-sense input\nConditioned 0...AON signal only"
		(exclude_from_sim no)
		(at 22.86 88.9 0)
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "49a36328-e20f-4df2-b877-026bfba2a56a")
	)
	(text "Inputs and outputs"
		(exclude_from_sim no)
		(at 156.21 63.5 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "76282358-3a8c-4d96-b057-825f011d4a50")
	)
	(text "Unused comparator channels\nInputs fixed; outputs disconnected"
		(exclude_from_sim no)
		(at 22.86 112 0)
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "7d551fbf-7ab3-446c-8e82-0110ee9d9fa0")
	)
	(text "HIGH = healthy\nLOW = fault"
		(exclude_from_sim no)
		(at 115.57 69.85 0)
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "7d922d1a-75aa-45cd-9ebb-40ca19729d6e")
	)
	(text "3200_PM_NEGATIVE_OVERCURRENT"
		(exclude_from_sim no)
		(at 20.32 19.05 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "801dba02-08e1-4293-b84b-8f87738dbbfb")
	)
	(text "Protection and fault response"
		(exclude_from_sim no)
		(at 156.21 132.08 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "8aaf4aef-275b-48f6-9000-c12a1ab8c4df")
	)
	(text "This hardware comparator checks the negative AFE rail current.\nIt can clear the power permit latch without waiting for STM32G0B1\nfirmware, protecting the supplies used by the matrix drivers."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "8b218169-32ae-4ce2-a1eb-7165433a603a")
	)
	(text "Purpose and role"
		(exclude_from_sim no)
		(at 156.21 40.64 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "c87b4f5f-43b8-4312-8a0e-56c8ea3a66fd")
	)
	(text "Channel 1 compares OC_I_N15 at IN1- with the reference at IN1+.\nAbove the threshold, the open-collector output pulls OC_OK_N LOW.\nR3203 (10 kOhm) pulls the released output HIGH. The other three\nchannels have fixed inputs and disconnected outputs."
		(exclude_from_sim no)
		(at 156.21 91.16 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "d751e3d9-4cc0-4a42-b89c-cb12302fea83")
	)
