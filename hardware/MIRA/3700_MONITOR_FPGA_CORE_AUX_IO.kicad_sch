	)
	(text "U3701-U3704 sense CORE_RAW/CORE1V0, AUX18_RAW/AUX1V8,\nAUX25_RAW/AUX2V5 and IO33_RAW/IO3V3 across upstream shunts.\nMON_I_* outputs report forward current; MON_V_* outputs report half\nthe post-shunt rail voltage. AON supplies all four monitors."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "4c01a745-1b7e-4baf-ae67-311f80f06a94")
	)
