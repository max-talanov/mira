	)
	(text "This sheet supervises the FPGA core, 1.8 V and 2.5 V auxiliary domains\nand the 3.3 V I/O supply. These domains support MIRA's matrix timing,\nADC capture and host data path. Current and load-side voltage telemetry\nlets the power manager check startup and diagnose domain faults."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
