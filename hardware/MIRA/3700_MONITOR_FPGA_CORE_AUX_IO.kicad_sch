	(text "BAT54S clamps each voltage node to GND and AON; 10 kOhm resistors\nlimit the injected current. The current-output RC does not delay the\ninternal overcurrent comparator. These monitors report faults; they do\nnot interrupt power locally. Qualify all readings with AON availability."
		(exclude_from_sim no)
		(at 156.21 136.88 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "024b8228-9302-439b-99c8-2c6f4eaea631")
	)
