	)
	(text "Each channel compares its monitor voltage with an AON-derived reference. A\nmonitor above the reference releases its output HIGH; a monitor below it pulls\nthe output LOW. These are four independent status channels. No overvoltage\nwindow or fault memory is implemented here."
		(exclude_from_sim no)
		(at 156.21 91.16 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "e08af9f4-5e56-4592-b4b7-4eb57ed5c79a")
	)
	(text "Protection and fault response"
		(exclude_from_sim no)
		(at 156.21 132.08 0)
