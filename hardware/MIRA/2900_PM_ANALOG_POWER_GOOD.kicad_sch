	(text "Vref = AON x 10k / (Rtop + 10k). At AON = 3.28 V: USB 2.231 V; ANA6 2.689 V; P15\n2.360 V; N15 1.312 V. C2901-C2904 filter the references, with tau about 32, 18,\n28 and 60 us. Actual rail trip voltages depend on upstream monitor scaling."
		(exclude_from_sim no)
		(at 156.21 114.02 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "9eb31051-d727-4ad4-a0e9-9ee0353c9324")
	)
