	)
	(text "U2901 creates hardware supply-status signals for MIRA's USB, analog preregulator\nand bipolar AFE power domains. The power controller and rail-ready logic use\nthese signals before allowing matrix operation. This block checks supply levels;\nfast matrix pulse timing is handled elsewhere."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "aaee1a73-eb32-4074-9731-3d7d605b8b73")
	)
	(text "Inputs and outputs"
		(exclude_from_sim no)
		(at 156.21 63.5 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "aba73980-0afe-4e31-9b89-919c1824db41")
	)
	(text "MON_V_USB, MON_V_ANA6, MON_V_P15 and MON_V_N15 connect to the four non-inverting\ninputs. PG_USB, PG_ANA, PG_P15 and PG_N15 are open-collector outputs pulled to\nAON by R2909-R2912 (10 kOhm). U2901 and C2905 (100 nF) use AON and GND."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "afcad968-5995-4751-ba47-e725e7a6c46b")
	)
