	)
	(text "The INA301 ALERT outputs share OC_OK_N and pull it low on an overcurrent.\nGrounded RESET pins select transparent mode. The interlock sheet stores faults\nand removes supply permits; telemetry polling is not required for the hardware\nalert."
		(exclude_from_sim no)
		(at 156.21 91.16 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "9bf53123-9cae-4956-bdcc-ff892417baca")
	)
	(text "P15 voltage scale\n47 kOhm / 10 kOhm: 15 V -> 2.63 V\nAlso feeds hardware power-good."
		(exclude_from_sim no)
		(at 91.44 45.72 0)
