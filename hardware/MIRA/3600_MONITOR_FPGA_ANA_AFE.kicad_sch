	)
	(text "U3601-U3603 sense FPGA_RAW/FPGA5V5, ANA_RAW/ANA6 and P15_RAW/P15 across the\nupstream shunts. MON_I_* and MON_V_* feed the telemetry multiplexers. MON_V_ANA6\nand MON_V_P15 also feed the analog power-good sheet. AON powers all three\nmonitors."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
