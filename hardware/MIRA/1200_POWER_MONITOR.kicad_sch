	(text "L1201 (1 uH) and C1207-C1212 (6 x 47 uF) filter CORE_RAW.\nC1205 (100 nF) is the bootstrap capacitor; C1206 (4.7 uF) bypasses VREG5.\nR1207 (200 kOhm) / R1208 (10 kOhm) select 400 kHz FCCM and ILIM.\nC1203 (22 nF) sets about 2.2 ms soft start. The 8 A IC capability\nrequires sufficient input power and verified board thermal performance."
		(exclude_from_sim no)
		(at 156.21 90.5 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "0b15e32c-2187-4f81-86c5-b09350b13f50")
	)
	(text "Conversion and filtering"
		(exclude_from_sim no)
		(at 156.21 85.7 0)
		(effects
			(font
				(size 1.9 1.9)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "24528cf3-4134-40a5-9ebb-4d75b21ab636")
	)
	(text "Mode setting"
		(exclude_from_sim no)
		(at 91 145 0)
		(effects
			(font
				(size 1.6 1.6)
				(thickness 0.18)
				(bold yes)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "38775f6c-4556-4ffe-8161-9c56b2760f5f")
	)
	(text "CORE1V0 supplies the FPGA internal logic used by the MIRA matrix engine,\nprecise switching and ADC timing, and fast USB/Ethernet data handling.\nIt is separate from the FPGA auxiliary and I/O supplies. Generating it\nfrom FPGA5V5 keeps the core in the controlled FPGA power branch."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "43adabf8-ec25-40f8-ad1f-426496480d8c")
	)
	(text "1200_POWER_MONITOR / FPGA core supply"
		(exclude_from_sim no)
		(at 20.32 19.05 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "4b9ece72-aab1-4cfe-9382-6f3338f31c6c")
	)
	(text "Output voltage setting"
		(exclude_from_sim no)
