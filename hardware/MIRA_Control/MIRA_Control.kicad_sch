		)
		(uuid "21f77a6e-7d41-466d-af0d-aba3a370cf03")
	)
	(text "Thirty-two BL voltages plus service voltage and current\ncommands. The shared source-side CV/CC regulator is on\nsheet 2100; polarity is selected by matrix routing."
		(exclude_from_sim no)
		(at 22.86 153.67 0)
		(effects
			(font
				(size 1.2 1.2)
