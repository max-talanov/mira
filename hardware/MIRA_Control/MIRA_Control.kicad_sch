			)
			(justify left top)
		)
		(uuid "33cbfbc8-2520-4651-96c0-1661ce128481")
	)
	(text "Source-side Kelvin current sensing, shared PI control with\nbounded command and reset, independent backup overcurrent\ntrip, configuration fault latch and external inhibit."
		(exclude_from_sim no)
		(at 22.86 232.41 0)
		(effects
