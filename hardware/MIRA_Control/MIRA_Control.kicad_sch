		(uuid "14b207fa-d2ad-404b-862a-1f582013e7b9")
	)
	(text "Artix-7 supplies, configuration, USB FIFO, DDR3L, Ethernet\nPHY and buffered MCU link. All FPGA sections belong to one\nphysical package."
		(exclude_from_sim no)
		(at 284.48 74.93 0)
		(effects
			(font
