	(lib_symbols)
	(text "Explicit Control-side power and permission connector.\nSeparate SYS3V3 and IO3V3 receivers prevent joining\ndisabled receiver domains."
		(exclude_from_sim no)
		(at 153.67 74.93 0)
		(effects
			(font
				(size 1.2 1.2)
				(color 0 70 160 1)
