	)
	(text "CS_BL0, CS_BL1, CS_BL2 and CS_BL3 select the four groups of eight bit-line outputs. CS_CTRL selects the service voltages and current-limit references. CS_HV\nselects the separate AD5761R forming source. The 10k bias resistors keep the select lines inactive when the FPGA pins are not driving."
		(exclude_from_sim no)
		(at 224 57.959 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "95d53b92-3ede-4b9f-b9a7-8acbe91f4a3d")
	)
	(text "FPGA DAC timing interface"
		(exclude_from_sim no)
		(at 43.18 24.5 0)
		(effects
			(font
				(size 1.65 1.65)
				(bold yes)
				(color 25 47 72 1)
			)
			(justify left top)
		)
		(uuid "9b859872-099d-4974-869f-0b0617d175f3")
	)
	(text "HV_ALERT_N returns the forming DAC status to the FPGA. HV_CLEAR_N is a separate forming-DAC clear control. These signals serve the DAC interface and do not\nreplace MATRIX_PERMIT or the matrix fault latch."
		(exclude_from_sim no)
		(at 224 89.198 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "ab8694c4-b14a-4be7-b90d-7fed618d3639")
	)
