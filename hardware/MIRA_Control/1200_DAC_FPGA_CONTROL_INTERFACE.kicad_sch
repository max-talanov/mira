				(size 0.85 0.85)
				(color 0 70 190 1)
			)
		)
		(uuid "2e1eaae8-81ac-4e5d-a8fe-1683e3e335c6")
	)
	(text "Individual device selection"
		(exclude_from_sim no)
		(at 224 52.619 0)
		(effects
