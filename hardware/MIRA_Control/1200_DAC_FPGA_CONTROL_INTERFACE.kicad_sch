	)
	(text "DAC_LDAC_N is distributed to the DACs for coordinated output updates. DAC_RESET_N provides a common hardware reset. Their exact effect on output codes also\ndepends on the DAC configuration and reset selection; firmware must establish known setpoints before enabling the matrix routing."
		(exclude_from_sim no)
		(at 224 73.579 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "6e7f6363-ff6d-487f-9382-ec12c9fc26ce")
	)
