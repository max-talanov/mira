	)
	(text "This section of U500 drives DAC_SPI_SCK and DAC_SPI_MOSI and receives DAC_SPI_MISO. The bus reaches four bit-line DACs, the service DAC and the forming\nDAC. Select only the intended device during each transfer; its output data share the same return wire."
		(exclude_from_sim no)
		(at 224 42.34 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "2acefd57-ea08-49c3-a87b-f8539492f295")
	)
	(text "U500\nVCCO34"
		(exclude_from_sim no)
		(at 92.71 147.32 0)
		(effects
