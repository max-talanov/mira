		)
		(uuid "355195f5-85a7-4f08-b61a-a2f5b9836118")
	)
	(text "The illustrated FPGA bank uses IO3V3. Its local 47u, 4.7u and 470n capacitors support the bank supply; the analog DAC and amplifier supplies are shown on\ntheir own circuit sheets."
		(exclude_from_sim no)
		(at 224 104.818 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "3584b44d-74cf-4546-b21e-78aea47b6913")
	)
