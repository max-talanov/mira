	(text "U1900 holds MAT_TIA_IN near GND and converts input current into\nMAT_TIA_OUT. In the ideal low-frequency model VOUT = -IIN x REFF.\nREFF includes R1900 (10 MOhm) in parallel with the selected branch,\nincluding switch resistance. C1903 (2.2 pF) remains in feedback at\nevery gain."
		(exclude_from_sim no)
		(at 22.86 174.34 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "882980d0-462f-4da7-92d9-b2d6a8225558")
	)
	(text "6"
		(exclude_from_sim no)
		(at 90.17 125.73 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left)
		)
		(uuid "9886f099-b067-47d7-9fe1-748656ce1385")
	)
	(text "U1902 selects TIA, BL service, NL service, buffered current sense or\nbuffered ILIM. Codes 5-7 select GND. U1903A isolates the INA821\noutput; U1903B buffers the target for the controller, trip divider and\nmonitor mux. The sheet 2000 buffer isolates the ADC gain network."
		(exclude_from_sim no)
		(at 214.36 174.34 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "cc5d06f6-2285-4066-9c8f-70ad7fb913da")
	)
	(text "Matrix current conversion and monitor selection"
		(exclude_from_sim no)
		(at 22.86 14.5 0)
		(effects
			(font
				(size 1.8 1.8)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "d290ad4a-8983-4060-a871-8678dabefdd2")
	)
	(text "TIA and permanent feedback"
