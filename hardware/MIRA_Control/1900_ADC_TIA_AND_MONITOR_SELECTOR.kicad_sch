	(text "U1901 connects one paired resistor/capacitor branch across the amplifier.\nAddress codes 0-4 select 100 Ohm/330 pF, 1 kOhm/100 pF, 10 kOhm/33 pF,\n100 kOhm/10 pF, or 1 MOhm/3.3 pF. Codes 5-7 repeat the 100 Ohm/330 pF\nbranch. Each selected branch operates in parallel with the permanent feedback\nnetwork; switch resistance also affects the effective transimpedance."
		(exclude_from_sim no)
		(at 118.61 174.34 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "71f3da87-642d-4703-a1af-98f0112d02a4")
	)
