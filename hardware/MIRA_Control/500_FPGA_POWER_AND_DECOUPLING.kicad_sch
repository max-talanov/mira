	(text "All U500 units shown here belong to the XC7A200T-2FBG484I. CORE1V0 feeds\nVCCINT and VCCBRAM; AUX1V8 feeds VCCAUX. These rails serve different internal\ncircuits and remain separate even though their return is the common GND\nnetwork."
		(exclude_from_sim no)
		(at 315 42.34 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "219277e2-c4a7-4e97-ac40-8e15b260c1ca")
	)
