		(uuid "81ccdb17-f10b-4aca-9884-a5c6d7a74a05")
	)
	(text "Power and supervision interface"
		(exclude_from_sim no)
		(at 22.86 14.5 0)
		(effects
			(font
				(size 1.8 1.8)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "8936ad07-e381-4d40-8e37-15cfb659034a")
	)
	(text "U400 uses SYS3V3 for the MCU-side power-good, permit and UART\nsignals. U401 uses IO3V3 for the matrix logic. Both Nexperia\ndevices specify Ioff, so an AON-powered supervisor does not\ndrive a disabled receiver domain through its outputs."
		(exclude_from_sim no)
		(at 315 67.5 0)
		(effects
			(font
				(size 1.15 1.15)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "b6123f4b-9a1e-4c6d-86ee-e5bfffc27de2")
	)
	(text "Permission and hardware inhibit"
		(exclude_from_sim no)
		(at 315 81.9 0)
		(effects
			(font
				(size 1.45 1.45)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "c468df66-5f9f-47fb-8fde-5842c1f9ba5c")
	)
	(text "J400: HTSW-110-07-S-D <-> Power J4901: SSW-110-01-S-D.\nPower entry: J401..J407 on INTERCONNECT sheets 410 and 420.\nControl headers B.Cu; Power sockets F.Cu; facing gap 12 mm.\nAlign each pair by pin 1 and pin 2 in common board coordinates.\nNo hot-plug; verify all eight pairs together before PCB release."
		(exclude_from_sim no)
		(at 315 45 0)
		(effects
			(font
				(size 1.15 1.15)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "d0db9c8e-ea9d-42b4-8a6c-d9d4cf4445b7")
	)
	(text "Distributed physical power inputs"
		(exclude_from_sim no)
		(at 315 39 0)
		(effects
			(font
				(size 1.45 1.45)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "e1936664-11d3-4115-a652-85658332a663")
	)
	(text "Required supply contract"
		(exclude_from_sim no)
		(at 315 104.4 0)
		(effects
			(font
				(size 1.45 1.45)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "e1a28db9-23cc-431f-9f6f-8c5a75827062")
	)
	(text "MATRIX_PERMIT_POWER is the common supervisor permission. Its two\nbuffered outputs remain separate nets. The matrix receiver is\npulled low on sheet 1300. MAT_FAULT_Q produces MATRIX_INHIBIT_N\nthrough Q2203; the new connector now exposes that output to the\nPower supervisor."
		(exclude_from_sim no)
		(at 315 87.9 0)
		(effects
			(font
				(size 1.15 1.15)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "e295534e-49ba-4acd-a4bb-3e2086679db3")
	)
