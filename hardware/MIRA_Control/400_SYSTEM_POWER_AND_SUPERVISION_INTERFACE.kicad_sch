	(text "Control-side pin assignment; AON = 3.3 V. Match the mating Power board before PCB release."
		(exclude_from_sim no)
		(at 22.86 23 0)
		(effects
			(font
				(size 1.1 1.1)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "06330826-2f8f-4a88-8cb7-a81e92c1b1db")
	)
	(text "J400 - supervisor signals and AON"
		(exclude_from_sim no)
		(at 40 73.66 0)
		(effects
			(font
				(size 1.3 1.3)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "0bff409c-fb9b-4d94-adf3-58d0117336f1")
	)
	(text "AON is 3.3 V and starts before SYS3V3/IO3V3. VTT must source and\nsink at DDR1V35/2; DDR_VREF is a quiet reference at the same\nnominal level. P15/N15 and PROG_P15/PROG_N15 are separate analog\ndomains. Signal mapping is defined here, not inferred from a\nmissing mating board."
		(exclude_from_sim no)
		(at 315 110.4 0)
		(effects
			(font
				(size 1.15 1.15)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "33cad342-f851-4a17-ace7-38c622cc23a6")
	)
	(text "Inputs from Power are 3.3 V logic. PG/permit default low; UART defaults high.\nHOST_RESET_N is driven only by an open-drain reset source. MATRIX_INHIBIT_N is\nan open-drain return to Power with an AON pull-up here. Watchdog/alive default low."
		(exclude_from_sim no)
		(at 22.86 263 0)
		(effects
			(font
				(size 1 1)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "42201c55-02e2-4c5d-86a1-862480d45445")
	)
	(text "Shared Power permit is received independently\nin SYS3V3 and IO3V3; these output nets are not shorted."
		(exclude_from_sim no)
		(at 171.45 181.61 0)
		(effects
			(font
				(size 1.1 1.1)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "4cc96f1b-7960-4b39-a66a-cb979eb6e456")
	)
	(text "IO3V3 permit receiver"
		(exclude_from_sim no)
		(at 175.26 144.78 0)
		(effects
			(font
				(size 1.3 1.3)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "6ee7552b-c8f0-48a2-8671-4ee1c43632e4")
	)
	(text "Separate receiving domains"
		(exclude_from_sim no)
		(at 315 61.5 0)
		(effects
			(font
				(size 1.45 1.45)
				(color 0 70 160 1)
			)
