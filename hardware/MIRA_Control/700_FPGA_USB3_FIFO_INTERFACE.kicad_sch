	(text "J700 is the USB Type-C port. U706, the HD3SS3220, handles CC detection\nand SuperSpeed lane orientation. U707, the FT601Q-B-R, terminates the USB\nlink and presents a parallel FIFO to FPGA bank 14. USB_DP and USB_DM connect\nthe USB2 pair directly to the FT601 interface."
		(exclude_from_sim no)
		(at 315 42.34 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "2fd15f0a-77ae-449f-a0f2-e19afb899c26")
	)
