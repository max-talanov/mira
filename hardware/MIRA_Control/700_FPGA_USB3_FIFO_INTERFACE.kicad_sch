	(text "FT_D0 through FT_D31 form the 32-bit bidirectional data bus; FT_BE0 through\nFT_BE3 identify valid bytes. FT_CLK provides the interface clock. RXF_N and\nTXE_N report FIFO availability, while RD_N, WR_N and OE_N control transfers.\nSIWU_N and the GPIO signals are also brought into the control network."
		(exclude_from_sim no)
		(at 315 62.306 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "5cb4614b-08a5-4f7c-b17a-01a4bdc810fc")
	)
