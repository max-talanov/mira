	)
	(text "Y700 uses a 30 MHz crystal and two 22 pF capacitors; R705 is 1.6 kohm.\nR703 (10 kohm) and R704 (15 kohm) form a 3.0 V nominal VBUS divider.\nU708, a 74LVC1G17GV Schmitt buffer on IO3V3, drives FT_VBUS_DET and\nisolates the FT601 when IO3V3 is off. C732 bypasses U708; R714 holds\nits output low when unpowered. Data/CC protection remains at the port."
		(exclude_from_sim no)
		(at 315 102.239 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "711f0dfc-021e-4cc3-b1e6-7e612d7ff7f7")
	)
