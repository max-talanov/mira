	(text "U1516-U1519 each select one bit line from their eight-channel group.\nMAT_BL_A0, MAT_BL_A1 and MAT_BL_A2 are shared address inputs. The selector\noutputs are MAT_BL_BANK_0-3; the upper address selection on the service-router\nsheet chooses which bank reaches MAT_BL_SERVICE."
		(exclude_from_sim no)
		(at 315 84.446 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "dc190071-4b83-43eb-8ee8-f93c16af6d70")
	)
	(text "BL26 / DAC + GND"
		(exclude_from_sim no)
		(at 130.81 208.28 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left)
		)
		(uuid "e927978a-c13e-47e7-982a-76fcf0e16c38")
	)
	(text "This sheet contains BL0-BL31 in four groups of eight. Each terminal has two\nTMUX7212 paths: buffered DAC drive and GND clamp. VMM is voltage drive;\nthere is no per-cell current compliance. Firmware must enforce the current\nand TIA limits from docs/pcb-preparation/analog-requirements/." (exclude_from_sim no) (at 315 42.34 0) (effects (font (size 1.35 1.35) (color 0 70 160 1)) (justify left top)) (uuid "efe56170-fa2c-408e-bc47-bbabfda8ea89"))
