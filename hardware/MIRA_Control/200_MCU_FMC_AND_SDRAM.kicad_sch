	)
	(text "R223 pulls chip select high and R224 pulls clock enable low while the MCU pins\nare not actively driving them. U200 uses SYS3V3. Seven 100 nF capacitors and\nthe 4.7 uF C207 provide local bypass and a supply reservoir."
		(exclude_from_sim no)
		(at 315 100.065 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "b2962063-b5d1-452c-9762-675a03dd0ae9")
	)
	(text "Main MCU 64 MiB SDRAM | Rev.A"
		(exclude_from_sim no)
		(at 157.48 33.02 0)
		(effects
			(font
				(size 1 1)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "bb4db30b-1357-4a0c-905b-b13de485e4cb")
	)
	(text "FMC_SDNRAS, FMC_SDNCAS and FMC_SDNWE encode SDRAM commands.\nFMC_SDNE0 selects the device and FMC_SDCKE0 controls clock enable.\nFMC_SDCLK is routed through the separate 33 ohm R222. The other shown\nsource-damping resistors are 22 ohms."
		(exclude_from_sim no)
		(at 315 80.099 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "be92eb52-abe9-4f85-b99f-890922876d72")
	)
