	(text "Configure the FMC geometry, command sequence, timing parameters and refresh\ninterval for this exact memory before application use. The schematic does not\ndefine those software values. Keep the clock, command and data routes\ncontrolled as a synchronous bus; retain the resistor-to-signal association shown\nhere."
		(exclude_from_sim no)
		(at 315 117.858 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "4bec92fa-e888-4825-bd8c-fe9688a17864")
	)
	(text "FMC_D0 through FMC_D15 form the bidirectional data bus. FMC_A0 through\nFMC_A12 and FMC_BA0/FMC_BA1 select the row, column and internal bank\naccording to the SDRAM command. FMC_NBL0 and FMC_NBL1 connect the two\nbyte masks, allowing access to either half of the 16-bit word."
		(exclude_from_sim no)
		(at 315 60.133 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "56594a46-624b-4c5a-85b9-d8bb7e54aeb2")
	)
	(text "Memory path"
		(exclude_from_sim no)
		(at 315 37 0)
		(effects
			(font
				(size 1.55 1.55)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "676f4f54-f453-49af-a747-075fe91c1352")
	)
