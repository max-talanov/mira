			(justify left)
		)
		(uuid "ac887837-9818-4118-af64-3c99f612f0b4")
	)
	(text "U1408 provides MAT_WL_ON_0-7 for the eight word-line selectors. U1409\nprovides MAT_NL_ZERO_0-7 for the eight neuron-line ground clamps. The\nselected measurement line must have its clamp released before routing it to the\nanalog return."
		(exclude_from_sim no)
		(at 315 82.273 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "af249cc4-8f59-4c81-80f5-57679fc6b3e3")
	)
	(text "Serial chain and stored image"
		(exclude_from_sim no)
		(at 315 37 0)
		(effects
			(font
				(size 1.55 1.55)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "d0384419-d32a-4599-a3f9-9fc1072636e2")
	)
	(text "U1400-U1403 supply the 32 MAT_BL_VMM_0-31 controls that connect individual\nDAC outputs to their bit lines. U1404-U1407 supply MAT_BL_ZERO_0-31 for the\nindependent ground clamps. Firmware must avoid enabling a DAC connection and\nits ground clamp at the same time."
		(exclude_from_sim no)
		(at 315 62.306 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "eb349e67-b086-420d-ae44-018fd6e19a8d")
	)
	(text "Eighty-bit switch-control image"
		(exclude_from_sim no)
		(at 22.86 14.5 0)
