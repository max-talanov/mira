	(text "Start SDCLK at 50MHz. Use 13 row bits, 10 column bits, four banks and\n16-bit width. Series damping is on 4500A."
		(exclude_from_sim no)
		(at 154.94 119 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "04d69e76-6103-4bf4-943a-bea2d3afb798")
	)
	(text "U4101 exposes the complete 16-bit FMC SDRAM bus. External bank 1\nbegins at 0xC0000000."
		(exclude_from_sim no)
		(at 154.94 44 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 33 43 55 1)
