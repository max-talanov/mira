	(text "Serial image: 1400\nAnalogue routing: 1600\nAFE / ADC / fault: 1900-2200"
		(exclude_from_sim no)
		(at 22.86 391.16 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left)
		)
		(uuid "66b1f258-985e-4273-8c45-12f950a6db31")
	)
	(text "MAT_CONFIG_LATCH = MAT_SPI_LATCH & MAT_SPI_OE_N. Only a\ncommit with outputs disabled clocks the 80-bit mask chain,\nboth 8-bit configuration registers and frame arm. Keep\nLATCH low during OE changes. Hold all inputs stable around\nthe qualified edge."
		(exclude_from_sim no)
		(at 510.54 82.805 0)
		(effects
			(font
				(size 1.08 1.08)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "6f7919fd-bab7-4cc5-85ec-99c644c3a84e")
	)
	(text "Matrix commands and hardware interlocks"
		(exclude_from_sim no)
		(at 22.86 14.5 0)
		(effects
			(font
				(size 1.8 1.8)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "70d0fa6a-94bc-462b-b0fc-4b8962db5aa1")
	)
	(text "MAT_FRAME_VALID remains an HDL assertion: there is no\nexternal 80-clock counter, CRC or per-line mask checker.\nValidate exact frame length, no VMM/ground overlap, legal\nselected-line clamps and suitable WL selection. Address\nfreeze does not validate the crossbar image."
		(exclude_from_sim no)
		(at 510.54 265.685 0)
		(effects
			(font
				(size 1.08 1.08)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "781ec451-1dc7-4ea5-aaa5-7a2857ea9069")
	)
