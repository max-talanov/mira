	(text "One atomic configuration commit"
		(exclude_from_sim no)
		(at 510.54 77.47 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "182a4be4-fc1b-4094-a202-9d673c590926")
	)
	(text "Write command protection"
		(exclude_from_sim no)
		(at 510.54 214.63 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "1ec4b997-834e-4f51-bb38-3f6819456927")
	)
	(text "SERVICE_READ requires source code 00. SERVICE_WRITE\nrequires 01 SET, 10 RESET or 11 FORM. VMM_READ does not use\nthe service-source code. The source and current-limit\nmultiplexers share captured SRC bits. READ forces the\nanalog programming range to its defined low-ohm setting."
		(exclude_from_sim no)
		(at 510.54 174.245 0)
		(effects
			(font
				(size 1.08 1.08)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "24f1fa60-c264-4017-862d-d55fee948d60")
	)
	(text "FPGA MATRIX ENGINE / BANK 35"
		(exclude_from_sim no)
		(at 17.54 37.54 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left)
		)
		(uuid "33c916fc-fce5-4c99-afd8-7f9bdab9387c")
	)
	(text "MAT_SOURCE_SAFE is SERVICE_READ or qualified WRITE_PULSE.\nIt now controls the source actuator, not a charged pulse\nswitch after current sense. Matrix capacitance and switch\ninjection remain in the energy budget. FPGA bounds pulse\nduration and enforces zero-source discharge before\nrerouting."
		(exclude_from_sim no)
		(at 510.54 357.125 0)
		(effects
			(font
				(size 1.08 1.08)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "35ee6eff-c3c0-4c23-9d49-d38657e7e5a6")
	)
	(text "Routes held during operation"
		(exclude_from_sim no)
		(at 510.54 123.19 0)
		(effects
