  (text "0010_EXTERNAL_SUPPLIES" (at 20.32 19.24 0) (effects (font (size 1.15 1.15) (color 86 96 108 1)) (justify left top)) (uuid "ca28085c-acca-53a7-8d53-3d1f1e9c106c"))
  (text "External supplies and references"
