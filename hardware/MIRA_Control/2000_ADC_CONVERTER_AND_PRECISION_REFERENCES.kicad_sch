	(text "Complete gain including sheet 3100:\nVDIFF / VMON = -0.148935704 nominal.\nC2006 is between IN+ and IN-." (exclude_from_sim no) (at 16.51 176.53 0) (effects (font (size 1 1) (color 0 70 160 1)) (justify left top)) (uuid "79b643b8-638f-40e5-ad71-853a7e03d1be"))
