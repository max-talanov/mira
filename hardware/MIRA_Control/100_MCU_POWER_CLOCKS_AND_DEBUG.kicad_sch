			)
			(justify left top)
		)
		(uuid "cec3295f-616d-4f97-a5dc-6f284cb6d4da")
	)
	(text "R106 and C132 bias and filter HOST_RESET_N; SW100 pulls it low. R102 holds\nBOOT0 low, while J101 permits a high strap. J100 exposes SWD, SWO, reset and\nthe supply reference. R103 and R104 are 33 ohm series resistors in SWD.\nPC6 (pin 122) receives FPGA_DONE_MCU and PC7 (pin 123) receives\nFPGA_INIT_N_MCU through the SYS3V3-powered U901 return buffer."
		(exclude_from_sim no)
		(at 315 122.205 0)
		(effects
			(font
				(size 1.35 1.35)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "ee743564-8404-4b9f-9c20-632cb65d68ef")
	)
