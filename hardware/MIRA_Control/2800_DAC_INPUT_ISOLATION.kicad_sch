(text "U2803: ILIM_SET_DAC -> ILIM_SET_DAC_SAFE, MATRIX_BIAS_DAC -> MATRIX_BIAS_DAC_SAFE" (at 15.24 245.10999999999999 0) (effects (font (size 0.85 0.85)) (justify left top)) (uuid "3db4846f-cda4-4916-82f0-7335f764fccf"))
(text "100 kOhm discharges the switch output; 1 kOhm limits amplifier input clamp current.\nThe discharge resistor is BEFORE the 1 kOhm, avoiding a 1% signal divider.\nAll protected sources are 0..5 V nominal. See gain/leakage and partial-supply qualification." (at 15.24 273.05 0) (effects (font (size 0.95 0.95)) (justify left top)) (uuid "295a3994-1ff0-4c43-a5ff-d65772d5ee86"))
