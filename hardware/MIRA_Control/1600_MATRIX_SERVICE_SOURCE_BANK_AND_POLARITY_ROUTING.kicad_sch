	(text "DNP BLEEDERS / PASSIVE CONTROL PULL-DOWNS\nR1600/R1601 must remain DNP for microamp operation. Power OFF discharges SOURCE through the selected shunt.\nBefore route/range changes: source OFF; run an explicit clamp/discharge frame.\nSource OFF isolates DUT lines; it does not prove their capacitance is discharged." (exclude_from_sim no) (at 20.32 340.36 0) (effects (font (size 1.2 1.2) (color 0 70 160 1)) (justify left top)) (uuid "868946e0-9aa7-45cf-bc57-24ad7ff6afd7"))
	(text "ERROR SELECTION\nOFF selects zero; ON selects regulator error.\nThe PI controller and shunts are on sheet 2100."
		(exclude_from_sim no)
		(at 381 135.89 0)
		(effects
			(font
				(size 1.2 1.2)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "8b7b5f62-eb74-40f1-847f-22bc543b3c33")
	)
	(text "RETURN PATH\nREAD: TIA virtual ground.\nWRITE: direct GND; old low-side sink removed."
		(exclude_from_sim no)
		(at 200.66 143.51 0)
		(effects
			(font
				(size 1.2 1.2)
				(color 0 70 160 1)
			)
			(justify left top)
		)
		(uuid "ae45536a-4dbf-4f03-bbaa-49b8ed756cf6")
	)
	(text "BL BANK SELECTION\nOnly the held service address is used.\nVMM isolates the service path."
		(exclude_from_sim no)
		(at 20.32 190.5 0)
		(effects
			(font
				(size 1.2 1.2)
