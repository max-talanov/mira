(rectangle (start 149.8600 215.9000) (end 281.9400 361.9500) (stroke (width 0.25) (type solid) (color 25 47 72 1)) (fill (type none)) (uuid "512e2ae7-41bf-49e9-bc27-9fb106b72812"))

(rectangle (start 13.9700 215.9000) (end 147.3200 361.9500) (stroke (width 0.25) (type solid) (color 25 47 72 1)) (fill (type none)) (uuid "f1ab205c-46ca-4b7f-a169-01a8397c32ec"))

(text "C30004 (100 nF) sets an output slew rate of approximately 0.5 V/ms, giving a\nnominal 48 ms ramp to 24 V. Increasing C30004 slows startup and reduces\ncapacitive inrush. Closing JP30001 grounds SHDN_N and disables U30001.\nReopening JP30001 enables operation and can reset an overload latch." (exclude_from_sim no) (at 154.9400 295.9100 0) (effects (font (size 1.8 1.8) (thickness 0.18) (color 33 43 55 1)) (justify left top)) (uuid "137166dc-8b8c-4493-8d52-6e934a76bc9c"))

(text "18-36 V input. UVLO 16.47 V rising; OVP 38.51 V rising. R30015 = 4.02k sets\n4.48 A nominal." (exclude_from_sim no) (at 154.9400 269.2400 0) (effects (font (size 1.8 1.8) (thickness 0.18) (color 33 43 55 1)) (justify left top)) (uuid "14671321-aec0-42bd-a2be-3beddc7a5961"))

(text "Voltage and current limits" (exclude_from_sim no) (at 154.9400 264.2200 0) (effects (font (size 2 2) (thickness 0.18) (bold yes) (color 0 100 110 1)) (justify left top)) (uuid "1ea1c1f4-8b0e-40eb-8876-0d5ef4a59921"))

(text "SHEET GUIDE / eFuse and Reverse Protection" (exclude_from_sim no) (at 154.8600 219.9000 0) (effects (font (size 1.25 1.25) (thickness 0.18) (color 86 96 108 1)) (justify left top)) (uuid "3f8d4cfa-01c1-47ea-8c30-a720b755ea12"))

(text "Status output" (exclude_from_sim no) (at 154.9400 312.4800 0) (effects (font (size 2 2) (thickness 0.18) (bold yes) (color 0 100 110 1)) (justify left top)) (uuid "569b4048-f2f1-4160-874a-8f028329e0c4"))

(text "eFuse and Reverse Protection" (exclude_from_sim no) (at 20.3200 219.7100 0) (effects (font (size 1.25 1.25) (thickness 0.18) (color 86 96 108 1)) (justify left top)) (uuid "66b5912f-33ca-4dcd-8057-88ef32be0c4a"))

(text "R30006-R30007 set the PGTH threshold to approximately 16.20 V rising and 15.16\nV falling. PG_INPUT asserts only when the output passes this threshold and\nU30001's internal pass transistor is fully enhanced. R30011 pulls this\nopen-drain signal up to AON." (exclude_from_sim no) (at 154.9400 317.5000 0) (effects (font (size 1.8 1.8) (thickness 0.18) (color 33 43 55 1)) (justify left top)) (uuid "9bf60572-005c-4fa1-80d4-9a553a0b2f8a"))

(text "+24V_FUSED supplies U30001 (TPS26631) through Q30003 (IRFR3410). U30001\ncontrols Q30003 via B_GATE; Q30002 provides gate pull-down under DRV control.\nTogether with U30001, these transistors provide reverse-polarity and\nreverse-current protection. The protected output is EFUSE_OUT. C30005-C30002\ndecouple the input; C30003 decouples the output. D30009 clamps negative output\ntransients." (exclude_from_sim no) (at 154.8600 246.1060 0) (effects (font (size 1.8 1.8) (thickness 0.18) (color 33 43 55 1)) (justify left top)) (uuid "c97bd917-9d8e-4bc3-bee8-3244cc851a8b"))

(text "Purpose and power path" (exclude_from_sim no) (at 154.8600 241.0860 0) (effects (font (size 2 2) (thickness 0.18) (bold yes) (color 0 100 110 1)) (justify left top)) (uuid "e9725f4f-1093-4863-81b3-03fe55d861ba"))

(text "Startup and shutdown" (exclude_from_sim no) (at 154.9400 290.8900 0) (effects (font (size 2 2) (thickness 0.18) (bold yes) (color 0 100 110 1)) (justify left top)) (uuid "e9942f9f-c2f0-472d-8ff3-bd1f9ecb37fd"))

(text "24 V Electronic Fuse and Reverse-Polarity Protection" (exclude_from_sim no) (at 154.8600 226.9000 0) (effects (font (size 2.6 2.6) (thickness 0.18) (bold yes) (color 25 47 72 1)) (justify left top)) (uuid "f2fe8853-fa73-400c-829a-e4095df4cfc1"))

