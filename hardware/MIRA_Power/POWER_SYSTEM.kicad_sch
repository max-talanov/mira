  (text "[C] CMD_* go to converters; PG_* / PGR_* and VTT return to POWER_CONTROL." (exclude_from_sim no) (at 20.32 151.1 0) (effects (font (size 0.81 0.81) (thickness 0.12) (color 0 70 190 1)) (justify left top)) (uuid "f31a8f74-0354-4bdc-8e86-7806f20e3c03"))
  (text "[S] Separate input / primary / secondary rail and shunt signals feed POWER_MONITOR." (exclude_from_sim no) (at 20.32 153.85 0) (effects (font (size 0.81 0.81) (thickness 0.12) (color 0 70 190 1)) (justify left top)) (uuid "742f9f72-8e08-497b-92fb-d2d0db40d70c"))
  (text "AON powers control / monitor and biases switches; SYS3V3 feeds the host-reset interface." (exclude_from_sim no) (at 20.32 156.6 0) (effects (font (size 0.81 0.81) (thickness 0.12) (color 0 70 190 1)) (justify left top)) (uuid "b96ae875-0730-4e4c-a32a-68689c67c8ae"))
  (text "Reference arrows group named signals; they do not electrically join separate channels." (exclude_from_sim no) (at 20.32 159.35 0) (effects (font (size 0.78 0.78) (thickness 0.12) (color 0 70 190 1)) (justify left top)) (uuid "c4e66293-d5c2-4d34-8540-72f4fecaf6c7"))
  (text "POWER_INPUT - Input protection" (exclude_from_sim no) (at 156.21 38.1 0) (effects (font (size 1.6 1.6) (thickness 0.15) (bold yes) (color 0 100 110 1)) (justify left top)) (uuid "e39423ad-c21b-422f-a408-3126a5afa898"))
  (text "Accepts the external 24 V DC input through the connector, fuse and eFuse. Bus filtering\nand the input shunt produce BUS24 for the primary converters. PG_INPUT and FLT_INPUT_N\nreturn directly to the power manager." (exclude_from_sim no) (at 156.21 41.9 0) (effects (font (size 1.3 1.3) (thickness 0.12) (color 33 43 55 1)) (justify left top)) (uuid "ffcf54eb-ae5d-4762-9cce-6350816f7efc"))
  (polyline (pts (xy 156.21 56.5) (xy 278.13 56.5)) (stroke (width 0.13) (type solid) (color 220 225 230 1)) (fill (type none)) (uuid "881af797-6b66-4848-bbec-746c0d1e540b"))
  (text "PRIMARY_POWER - Primary converters" (exclude_from_sim no) (at 156.21 57.785 0) (effects (font (size 1.6 1.6) (thickness 0.15) (bold yes) (color 0 100 110 1)) (justify left top)) (uuid "b94bc451-d644-44a5-acb6-d28812d7e50b"))
  (text "Converts BUS24 into always-on AON, USB5, SYS3V3, FPGA5V5, ANA6 and the bipolar P15/N15 AFE\nsupplies. AON powers monitoring and control while switched rails are off. CMD_* enables\nand PG_SYS/PG_FPGA status link to POWER_CONTROL." (exclude_from_sim no) (at 156.21 61.585 0) (effects (font (size 1.3 1.3) (thickness 0.12) (color 33 43 55 1)) (justify left top)) (uuid "ecf32d25-61fd-4da7-9af2-de293ef65624"))
  (polyline (pts (xy 156.21 76.185) (xy 278.13 76.185)) (stroke (width 0.13) (type solid) (color 220 225 230 1)) (fill (type none)) (uuid "edcd9f40-d981-4128-bd2a-04ca0e39d1ad"))
  (text "SECONDARY_POWER - Secondary converters" (exclude_from_sim no) (at 156.21 77.47 0) (effects (font (size 1.6 1.6) (thickness 0.15) (bold yes) (color 0 100 110 1)) (justify left top)) (uuid "398ad9c2-ac40-4591-b487-68aad9ed75e9"))
  (text "Uses FPGA5V5 for FPGA core, auxiliary, I/O, DDR and PHY rails; ANA6 feeds the low-noise\nANA5/ANA3V3 chain. DDR1V35 also feeds VTT and DDR_VREF. CMD_* enables, PGR_* status and\ndirect VTT sensing link to the power manager." (exclude_from_sim no) (at 156.21 81.27 0) (effects (font (size 1.3 1.3) (thickness 0.12) (color 33 43 55 1)) (justify left top)) (uuid "c5b15b5e-a838-41e7-963c-e3e07b30c68e"))
  (polyline (pts (xy 156.21 95.87) (xy 278.13 95.87)) (stroke (width 0.13) (type solid) (color 220 225 230 1)) (fill (type none)) (uuid "b04267e9-f93a-4cd4-a27b-a2ff6861343c"))
  (text "PROGRAM_SWITCHES - Program rail switches" (exclude_from_sim no) (at 156.21 97.155 0) (effects (font (size 1.6 1.6) (thickness 0.15) (bold yes) (color 0 100 110 1)) (justify left top)) (uuid "6ce363ed-9dfe-4a65-9f64-08b59cb717d9"))
  (text "Switches the P15 and N15 supplies into PROG_P15 and PROG_N15 under MATRIX_PERMIT. Gate\nclamps force the pass pairs off and output discharge removes stored rail charge.\nPROG_V_P15 returns directly to the controller ADC. These rails supply the downstream\nprogramming drivers." (exclude_from_sim no) (at 156.21 100.955 0) (effects (font (size 1.3 1.3) (thickness 0.12) (color 33 43 55 1)) (justify left top)) (uuid "6cbc7788-e255-4564-aa49-cad291009c2a"))
  (polyline (pts (xy 156.21 115.555) (xy 278.13 115.555)) (stroke (width 0.13) (type solid) (color 220 225 230 1)) (fill (type none)) (uuid "c029ea9e-6ca4-493c-b506-408691993ffa"))
  (text "POWER_CONTROL - Power manager" (exclude_from_sim no) (at 156.21 116.84 0) (effects (font (size 1.6 1.6) (thickness 0.15) (bold yes) (color 0 100 110 1)) (justify left top)) (uuid "e18845e3-03d9-43b6-8b39-34e25068b5b1"))
  (text "The AON-powered STM32G0B1 sequences rail commands, scans telemetry and checks readiness.\nWatchdogs and permit latches handle shutdown in hardware. It drives CMD_*, MATRIX_PERMIT\nand mux control, and receives status, ADC_V/ADC_I, VTT and program-voltage feedback." (exclude_from_sim no) (at 156.21 120.64 0) (effects (font (size 1.3 1.3) (thickness 0.12) (color 33 43 55 1)) (justify left top)) (uuid "8df8e5b8-d6f2-492d-b97b-1f9503fd023d"))
  (polyline (pts (xy 156.21 135.24) (xy 278.13 135.24)) (stroke (width 0.13) (type solid) (color 220 225 230 1)) (fill (type none)) (uuid "2ce0dfdf-72a6-4fdb-8757-e5ee9f60be1a"))
  (text "POWER_MONITOR - Power monitoring" (exclude_from_sim no) (at 156.21 136.525 0) (effects (font (size 1.6 1.6) (thickness 0.15) (bold yes) (color 0 100 110 1)) (justify left top)) (uuid "e7ea243f-ecf6-4f78-8f21-d0384b6642d9"))
  (text "Conditions rail voltages and shunt drops, selects 16 current/voltage pairs and buffers\nADC_V/ADC_I. MON_V_* and OC_I_N15 feed hardware readiness and negative-current\ncomparators; shared OC_OK_N reports overcurrent. MUX_A0..3 and MUX_DISABLE come from\nPOWER_CONTROL." (exclude_from_sim no) (at 156.21 140.325 0) (effects (font (size 1.3 1.3) (thickness 0.12) (color 33 43 55 1)) (justify left top)) (uuid "4d0b996d-c4a1-4d07-9b9c-0387ea6c5dcc"))
  (text "This overview shows the six power-system sheets present in this project." (exclude_from_sim no) (at 156.21 159 0) (effects (font (size 0.92 0.92) (thickness 0.12) (color 0 70 190 1)) (justify left top)) (uuid "61eb0efc-ca65-42d8-858e-d8562051c17b"))
)
