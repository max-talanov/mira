  (text "AON" (exclude_from_sim no) (at 81.28 121.285 0) (effects (font (size 0.92 0.92) (thickness 0.15) (bold yes) (color 0 0 0 1)) (justify left top)) (uuid "4037d932-542a-45c3-8b54-528ef2893b33"))
