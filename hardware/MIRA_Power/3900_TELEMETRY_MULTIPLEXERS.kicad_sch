	(text "Both CD74HC4067 devices share MUX_A0..MUX_A3 and MUX_DISABLE. A0 is the least\nsignificant bit: channel = A0 + 2*A1 + 4*A2 + 8*A3. LOW on MUX_DISABLE connects\nthe selected pair; HIGH disconnects both."
		(exclude_from_sim no)
		(at 156.21 91.16 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
