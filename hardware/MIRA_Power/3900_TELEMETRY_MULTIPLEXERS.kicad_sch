	)
	(text "U3901 selects MON_I_* current signals; U3902 selects matching MON_V_* voltage\nsignals. Their outputs, MUX_I_COM and MUX_V_COM, feed the ADC buffers. Channel\norder runs from INPUT and AON to ANA5 and ANA33."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "d097cfd5-fad8-419a-be04-fb86b24f2c9e")
	)
	(text "Shared address\nA0 is the LSB\nHIGH disables both"
		(exclude_from_sim no)
		(at 117.475 44.45 0)
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "e2798af6-a3f0-4bc2-abc6-083bc44c3890")
	)
	(text "C3901 and C3902 bypass the AON supply with 100 nF each. Firmware should disable\nthe selectors, change the address, enable them and allow the source, buffer and\nADC to settle before accepting either sample."
		(exclude_from_sim no)
		(at 156.21 114.02 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "e8a95b1a-c5a4-4741-972f-1abc84c366a5")
	)
