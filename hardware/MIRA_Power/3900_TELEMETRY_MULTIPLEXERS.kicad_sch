	(text "This sheet lets the MIRA power manager scan voltage and current for 16 supply\ndomains. The paired selectors reduce 32 monitor signals to two ADC paths for\nstartup checks, load tracking and fault diagnostics."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "378b5eec-5347-44a8-b8f7-5172f42b31a4")
	)
	(text "The selectors carry conditioned monitor signals within GND..AON. Upstream\ndividers and clamps provide signal protection. Disabled or unpowered selectors\ndo not provide valid telemetry; dedicated hardware fault logic acts separately."
		(exclude_from_sim no)
		(at 156.21 136.88 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "41d2fcb8-5c8e-491a-9a05-63c2bb428b51")
	)
