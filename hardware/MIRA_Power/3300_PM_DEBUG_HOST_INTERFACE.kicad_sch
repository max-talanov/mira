	(text "Power manager debug and host interface"
		(exclude_from_sim no)
		(at 156.21 26.24 0)
		(effects
			(font
				(size 2.05 2.05)
				(thickness 0.18)
				(bold yes)
				(color 25 47 72 1)
			)
			(justify left top)
		)
		(uuid "c746e511-3f1b-47f5-806c-f205015c8aa8")
	)
	(text "SWDIO / SWCLK use 33 Ohm series resistors; SWCLK has a\n100 kOhm pull-down. R3304 / C3301 filter ADC_VTT with a\nnominal 10 us time constant. The host must send falling\nHOST_WDI edges within the watchdog interval set on sheet 2500."
		(exclude_from_sim no)
		(at 156.21 114.02 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "e5b03d8b-2496-4264-b890-4cc4391f17dd")
	)
	(text "Purpose and role"
		(exclude_from_sim no)
		(at 156.21 40.64 0)
