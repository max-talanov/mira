	)
	(text "PM debug access\nAON reference; SWD and PM reset"
		(exclude_from_sim no)
		(at 22.86 23 0)
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "20474ce0-9165-4d1c-bec9-4efc15a41a67")
	)
	(text "This sheet links the AON power manager to the STM32H745\napplication controller. It carries UART, permits, rail status and\na watchdog heartbeat, and provides SWD access to STM32G0B1.\nThe separate VTT monitor checks the DDR termination supply."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "291d3fac-7e6f-47b4-aa8b-d174430e5e2c")
	)
	(text "Partial power down\nOutputs high impedance if SYS3V3 is OFF"
		(exclude_from_sim no)
		(at 85.09 164 0)
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "2935bf5c-46f2-4523-9d2b-738bb9154098")
	)
	(text "J3301 provides AON reference, GND, SWDIO, SWCLK and PM reset.\nJ3302 provides SYS3V3 reference, GND, UART in both directions,\nHOST_WDI and three buffered status signals. The reference\npins are connected to board rails; external tools must only sense them."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "4ae187e7-016d-4af6-9045-ecf7b77777ff")
	)
	(text "SHEET GUIDE / 3300_PM_DEBUG_HOST_INTERFACE"
		(exclude_from_sim no)
		(at 156.21 19.24 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "523549f5-5e2f-4c73-bd02-59bfc382e54b")
	)
	(text "U3301 buffers PM_UART_TX, MATRIX_PERMIT, ALL_RAILS_PG and\nGLOBAL_PWR_PERMIT into the SYS3V3 host domain. All enables are\nLOW. Host TX reaches PM receive through R3305; R3306 holds\nreceive LOW when undriven. R3307 holds PM transmit idle HIGH."
		(exclude_from_sim no)
		(at 156.21 91.16 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "6b4623fe-a4e9-47c9-8795-fc7214dcbe4e")
	)
	(text "VTT monitor\n1 kOhm / 10 nF; rail clamps"
		(exclude_from_sim no)
		(at 22.86 51 0)
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "790f0781-59eb-4733-a6a8-af04364b4c8e")
	)
	(text "Protection and fault response"
		(exclude_from_sim no)
		(at 156.21 132.08 0)
