			)
			(justify left top)
		)
		(uuid "f4c17aac-d8d4-4ad4-a1ce-a6fe9354fbda")
	)
	(text "D3301 clamps ADC_VTT toward GND and AON. U3301 supports\npartial power down; its outputs become high impedance when\nSYS3V3 is OFF. Host reset is routed separately from J3302.\nUART LOW during host power loss must be handled by firmware."
		(exclude_from_sim no)
		(at 156.21 136.88 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "ffb6ba7c-eb9f-4671-afaf-9ebcabc496b2")
	)
