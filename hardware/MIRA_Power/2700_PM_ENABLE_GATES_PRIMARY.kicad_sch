		(uuid "e9fafcf9-628d-4d14-b2b4-4af8e62f5dfd")
	)
	(text "All request and command lines have 100 kOhm pull-downs.\nC2701/C2702 (100 nF) bypass the two SN74HC08 supplies to GND.\nThis sheet contains no startup delay or voltage/current setting;\nthose settings belong to the sequencer and the rail circuits."
		(exclude_from_sim no)
		(at 156.21 114.02 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "fcbcc167-4f54-41ba-bcac-21fb0cbe8422")
	)
