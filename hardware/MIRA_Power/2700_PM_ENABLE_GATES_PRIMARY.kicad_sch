	(text "Clearing GLOBAL_PWR_PERMIT drives every command LOW, even if\na firmware request remains HIGH. A request released by the MCU\nalso goes LOW through its pull-down. Rail shutdown time depends\non the connected converter or switch and its output capacitance."
		(exclude_from_sim no)
		(at 156.21 136.88 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "45b407b2-b8e2-4a90-839c-151c04b38daf")
	)
	(text "Every channel uses the same rule:\nCMD_x = GLOBAL_PWR_PERMIT AND EN_REQ_x.\nBoth inputs must be HIGH to enable the rail. The power manager\nchooses the sequence; these gates add the hardware permission."
		(exclude_from_sim no)
		(at 156.21 91.16 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "5d9dfbcc-3d8b-4210-8cc6-6302928962fb")
	)
	(text "U2701 generates CMD_USB, CMD_SYS, CMD_FPGA and CMD_ANA.\nU2702 generates CMD_P15, CMD_N15, CMD_CORE and CMD_AUX18.\nEach channel receives GLOBAL_PWR_PERMIT and its corresponding\nEN_REQ signal from the power manager."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "690f630c-763e-4dde-b190-42aeae632ab3")
	)
	(text "Protection and fault response"
		(exclude_from_sim no)
		(at 156.21 132.08 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "71801f95-1b5e-4ccb-b4ca-908c5b3616ab")
	)
	(text "2700_PM_ENABLE_GATES_PRIMARY"
		(exclude_from_sim no)
		(at 20.32 19.05 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "818e3388-b7ee-4b94-a4f4-00f9abeb37e7")
	)
	(text "AFE / FPGA core / AUX1V8 requests"
		(exclude_from_sim no)
		(at 18 110.5 0)
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "88ff49ca-30e4-45f9-84b2-a944419133ab")
	)
	(text "Every CMD = request AND global permit"
