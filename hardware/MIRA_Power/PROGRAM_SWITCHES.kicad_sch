	)
	(text "Exports PROG_P15, GND and PROG_N15 through J2301 pins 1, 2 and 3. The\npositive rail monitor divides the output by 5.7: 15 V becomes about 2.632 V\nat PROG_V_P15. Its RC filter supports rail supervision before programming;\nthe controller ADC is on another sheet."
		(exclude_from_sim no)
		(at 156.21 121.64 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "2988e72f-3e85-4a49-9bd0-6c18c580d766")
	)
	(text "All three blocks share GND."
		(exclude_from_sim no)
		(at 20.32 152.4 0)
		(effects
