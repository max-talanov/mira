	)
	(text "Connects P15 to PROG_P15 for MIRA's positive program-drive domain. The\nopposed PMOS pair supports controlled startup, gate clamping and output\ndischarge. MATRIX_PERMIT controls this path; Q2104 also sinks the optocoupler\nLED currents used by the negative path."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
