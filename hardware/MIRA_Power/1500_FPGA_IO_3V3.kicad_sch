		(uuid "7d8224cf-36ee-4111-9211-d365dbfb5439")
	)
	(text "R1505 (0.02 Ohm) drops 20 mV/A outside feedback. At 3 A, IO3V3 is about 3.235\nV. R1506 (10 kOhm) bleeds the output. PGR_IO33 is open drain, pulled to AON\nby R1502 (10 kOhm); use its RAW status only with FPGA5V5 present. The IC\nsupports up to 3 A, subject to thermal and shared-input limits. Current and\nthermal protection are internal."
		(exclude_from_sim no)
		(at 156.21 141 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "7fe4b3a8-1f8e-4a75-85bc-237682b228c0")
	)
	(text "Enable control"
		(exclude_from_sim no)
		(at 22 27 0)
