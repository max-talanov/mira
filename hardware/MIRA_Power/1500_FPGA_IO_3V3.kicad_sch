	)
	(text "U1501 (TPS62130A) receives FPGA5V5 at AVIN and both PVIN pins. C1502 (10 uF)\nand C1503 (100 nF) bypass the input. CMD_IO33 drives Q1501; a high command\nenables EN_IO33. R1501 (100 kOhm) pulls EN low when Q1501 is off. FPGA5V5\nmust be available first."
		(exclude_from_sim no)
		(at 156.21 65.3 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "d8443bf3-ef76-44db-825f-c68024600244")
	)
