			)
			(justify left top)
		)
		(uuid "154f49d0-1a5c-4fb1-8255-814755f72654")
	)
	(text "RAW: 3.295 V nominal; shunt: 20 mV/A.\nPGR_IO33: RAW status, pulled up to AON."
		(exclude_from_sim no)
		(at 76 49.2 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "243b9a92-14c3-4edb-a510-b8e021116aea")
	)
	(text "L1501 (2.2 uH) and C1504 (47 uF nominal) filter the switched output. VOS\nsenses IO33_RAW; FSW tied to RAW selects the approximately 1.25 MHz mode as\nRAW rises. Power-save operation is automatic at light load. C1501 (10 nF) on\nSS/TR gives an approximately 5 ms ramp."
		(exclude_from_sim no)
		(at 156.21 90.5 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "3330ee4f-666b-4157-ad46-838245785ff6")
	)
