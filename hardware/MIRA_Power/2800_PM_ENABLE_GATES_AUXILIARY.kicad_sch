	)
	(text "All request and command lines have 100 kOhm pull-downs.\nC2801/C2802 (100 nF) bypass the two SN74HC08 supplies to GND.\nThis sheet adds no delay or analog threshold; sequence and settling\nchecks are handled by the power manager and readiness circuits."
		(exclude_from_sim no)
		(at 156.21 114.02 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "ae192291-bb41-428f-bcc3-61718b98a112")
	)
	(text "U2801 generates CMD_AUX25, CMD_IO33, CMD_DDR and CMD_PHY.\nU2802 generates CMD_VTT, CMD_ANA5 and CMD_ANA33.\nEach used channel receives GLOBAL_PWR_PERMIT and its matching\nEN_REQ input. The fourth U2802 gate is unused."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "d01af33b-4065-451e-a05e-cfa141c31534")
	)
