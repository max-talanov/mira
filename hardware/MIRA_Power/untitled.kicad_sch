	(text "FAST OFF CLAMP"
		(exclude_from_sim no)
		(at 55.88 83.82 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "0863923c-bd3a-43fa-a471-a6226e563066")
	)
	(text "R501 (62 kOhm) and R502 (20 kOhm) feed AON_FB from AON_RAW.\nThe nominal regulated voltage is:\nV(AON_RAW) = 0.8 V x (1 + R501 / R502) = 3.28 V.\nIncreasing R501 raises the voltage; increasing R502 lowers it.\nTo select another voltage, use R501 = R502 x (VOUT / 0.8 V - 1)."
		(exclude_from_sim no)
		(at 156.21 119.38 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "153c0849-a8ab-42e4-a9a0-6eb9f4280083")
	)
	(text "R503 (0.1 Ohm) connects AON_RAW to AON and drops 100 mV per ampere.\nFeedback senses AON_RAW, so this drop is not compensated:\nV(AON) = 3.28 V - I(AON) x 0.1 Ohm, approximately 3.18 V at 1 A.\nU501 is rated for up to 1 A, subject to thermal and component limits.\nCurrent limiting, short-circuit hiccup and thermal shutdown are internal."
		(exclude_from_sim no)
		(at 156.21 143.57 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "2378e514-7bab-4061-8479-eb13b673d49a")
	)
	(text "PERMIT OPTOCOUPLER DRIVER"
		(exclude_from_sim no)
		(at 64.77 124.46 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "274849ab-4473-4706-9811-98af55f0b5e6")
	)
	(text "U501 switches AON_SW at a nominal 400 kHz and uses PFM at light load.\nL501 (33 uH) transfers energy to AON_RAW; C504 and C505 (47 uF each)\nsmooth the output voltage. C503 (100 nF) connects AON_CB to AON_SW\nand supplies the bootstrap charge for the internal high-side MOSFET."
		(exclude_from_sim no)
		(at 156.21 97.79 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "358b733a-871e-46a7-ba11-4fbb95178f6a")
	)
	(text "Parallel 680R resistors; Q2509 turns on without AON. Permit turns the discharge off."
		(exclude_from_sim no)
		(at 36.83 148.59 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "45bd7c1c-5998-47bc-812b-9b3d159f61e6")
	)
