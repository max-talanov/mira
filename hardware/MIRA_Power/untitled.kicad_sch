	(text "U501 (LMR51610XDBVR) converts BUS24 into the AON supply.\nVIN and EN connect directly to BUS24, enabling automatic startup when\ninput voltage is sufficient. AON remains powered while BUS24 is available;\nit turns off if the upstream protection disconnects BUS24.\nC501 (100 nF) and C502 (4.7 uF) provide input bypassing."
		(exclude_from_sim no)
		(at 156.21 73.66 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "fe32a808-c79a-458e-8cfe-eb3caf9a5adf")
	)
