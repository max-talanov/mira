	(text "When permit is low, Q2506 shorts the pass gates to their common sources."
		(exclude_from_sim no)
		(at 55.88 86.36 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "6efaa973-9dad-462b-8331-f0ce750048db")
	)
	(text "This converter provides the AON supply for power-management and protection\nlogic. It allows the system to monitor conditions, control startup and\nhandle faults while the main switched power rails are disabled.\nAON is generated directly from BUS24 and does not depend on those rails.\nIt remains available only while BUS24 is powered; disconnecting BUS24\nalso removes power from the AON circuitry."
		(exclude_from_sim no)
		(at 156.21 46.93 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "82caaaba-2a12-4e76-a4d4-eb0c7ed9a398")
	)
	(text "MATRIX_PERMIT HIGH: Q2503 ramps PMOS gates down; U2502 disables Q2506 OFF clamp; Q2510 disables discharge.\nPermit LOW / no AON: Q2506 equalizes pass G-S; Q2509 discharges PROG_P15 through 680 || 680 = 340 Ohm.\nThis is a protected fixed +15 V switch, not a programmable DAC source. Discharge tau = 1.60 ms for 4.7 uF once ON.\nGate discharge delay, ramp time and external output capacitance must be measured in the assembled circuit."
		(exclude_from_sim no)
		(at 50.8 26.67 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "8b7e2feb-bba2-4bf3-9311-f645af86484b")
	)
