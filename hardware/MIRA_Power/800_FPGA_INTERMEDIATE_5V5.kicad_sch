	(text "BUS24 feeds U801 (LM76005RNPR). CMD_FPGA drives Q801 as an active-high source\nfollower; R802 (100 kOhm) pulls EN_FPGA low when Q801 is off. R801 (10 kOhm)\npulls the open-drain PG_FPGA output up to AON."
		(exclude_from_sim no)
		(at 156.21 65.3 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "3246bfae-9db9-4b7c-b99a-fe7ba6edb158")
	)
