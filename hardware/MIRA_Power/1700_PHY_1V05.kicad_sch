	)
	(text "L1701 (2.2 uH) and C1704 (47 uF nominal) filter the switched output. VOS\nsenses PHY_RAW; FSW tied to RAW selects the approximately 1.25 MHz mode as\nRAW rises. Power-save operation is automatic at light load. C1701 (10 nF) on\nSS/TR gives an approximately 5 ms ramp."
		(exclude_from_sim no)
		(at 156.21 90.5 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "cff2a5de-56d8-4d6d-ad2e-2157cbdf69b0")
	)
