			)
			(justify left top)
		)
		(uuid "8167a9a1-daf9-4b00-b06a-8348372fc364")
	)
	(text "R1705 (0.02 Ohm) drops 20 mV/A outside feedback. At 3 A, PHY1V05 is about\n0.9895 V. R1706 (10 kOhm) bleeds the output. PGR_PHY is open drain, pulled to\nAON by R1702 (10 kOhm); use its RAW status only with FPGA5V5 present. The IC\nsupports up to 3 A, subject to thermal and shared-input limits. Current and\nthermal protection are internal."
		(exclude_from_sim no)
		(at 156.21 141 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "91ecbede-1c4a-428f-aad2-598b44399fbe")
	)
	(text "SHEET GUIDE / 1700_PHY_1V05"
		(exclude_from_sim no)
		(at 156.21 19.24 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
