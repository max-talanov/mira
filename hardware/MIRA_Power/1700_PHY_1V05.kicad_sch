			)
			(justify left top)
		)
		(uuid "288696ba-fdd7-4eba-b510-39e30f648131")
	)
	(text "CMD_PHY drives Q1701; R1701 pulls EN low."
		(exclude_from_sim no)
		(at 22 31.2 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "2e04226a-2d6a-41e3-83b0-93ea35b73ecb")
	)
	(text "R1703 (4.99 kOhm) and R1704 (16 kOhm) set the RAW voltage:\nV(PHY_RAW)=0.8 V x (1+R1703/R1704) = 1.05 V.\nTo change it: R1703 = R1704 x (VRAW / 0.8 V - 1). Increasing R1703 raises the\nvoltage. DEF is grounded; the +5% margin is disabled."
		(exclude_from_sim no)
		(at 156.21 116 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "6c4e0426-b107-4d03-b149-0b786e36f1d1")
	)
	(text "Output sensing"
		(exclude_from_sim no)
		(at 76 45 0)
		(effects
			(font
				(size 1.6 1.6)
				(thickness 0.18)
				(bold yes)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "762b9df9-6876-4be4-a06e-3436926cf305")
	)
	(text "Buck conversion and filtering"
