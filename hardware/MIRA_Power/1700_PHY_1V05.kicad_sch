	)
	(text "U1701 (TPS62130A) receives FPGA5V5 at AVIN and both PVIN pins. C1702 (10 uF)\nand C1703 (100 nF) bypass the input. CMD_PHY drives Q1701; a high command\nenables EN_PHY. R1701 (100 kOhm) pulls EN low when Q1701 is off. FPGA5V5 must\nbe available first."
		(exclude_from_sim no)
		(at 156.21 65.3 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "fdf00050-f170-4c66-8c0b-521be5cf8996")
	)
