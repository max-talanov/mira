	(text "This converter supplies the 1.05 V core domain of MIRA's Ethernet PHY. The\nPHY provides the physical network link for the FPGA, carrying host commands,\nmeasurement data and diagnostics to and from Mira Studio. A separate rail\nlets the power manager control and supervise the Ethernet power domain."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "09c028ee-4676-4d1f-8249-5e9f4ffb2721")
	)
	(text "FPGA5V5 -> PHY_RAW; L1701 + C1704 filter the output.\nVOS and feedback sense RAW before R1705."
		(exclude_from_sim no)
		(at 22 81.2 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "0a3bc3bc-6806-46fb-bb22-9510da0d185d")
	)
	(text "Output and protection"
		(exclude_from_sim no)
		(at 156.21 136.2 0)
		(effects
			(font
				(size 1.9 1.9)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "19f5fb93-7aed-4832-b549-6320709e5500")
	)
	(text "1700_PHY_1V05"
		(exclude_from_sim no)
		(at 20.32 19.05 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
