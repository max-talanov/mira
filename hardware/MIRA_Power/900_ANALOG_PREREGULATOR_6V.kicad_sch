		(uuid "6ed03cf8-a2f5-4f6b-9ed2-feceb7b54d56")
	)
	(text "R902 (130 kOhm) and R903 (20 kOhm) set ANA_RAW:\nVRAW = 0.8 V x (1 + R902/R903) = 6.00 V.\nTo change the voltage: R902 = R903 x (VRAW/0.8 V - 1). Increasing the upper\nresistor raises VRAW."
		(exclude_from_sim no)
		(at 156.21 116 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "7e39e9dc-62a0-47ff-831d-fc835f01e9e6")
	)
