	)
	(text "R904 (0.05 Ohm) causes a 50 mV/A drop: ANA6 is about 5.95 V at 1 A. Feedback\nis before the shunt. U901 is a 1 A IC with internal current, short-circuit\nand thermal protection. D901 indicates rail presence; R904 does not set the\ncurrent limit."
		(exclude_from_sim no)
		(at 156.21 141 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "bba0def3-e4da-4c45-b89b-518cc25b42d9")
	)
	(text "CMD_ANA drives Q901 as a source follower.\nR901 pulls EN low when Q901 is off.\nThe command must have a defined level."
		(exclude_from_sim no)
		(at 23 31.2 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "ca56b3ba-892b-4ebb-824c-8831bac6d661")
	)
	(text "Generates ANA6 from BUS24 as an intermediate supply for downstream low-noise\nanalog LDO stages. CMD_ANA controls whether this supply is enabled."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "d0695c10-1fa9-45e2-817e-9d4bf2689ba3")
	)
	(text "U901 operates at 400 kHz with PFM at light load. L901 (33 uH) and C904/C905\n(47 uF each) filter ANA_RAW. C901/C903 bypass the input; C902 (100 nF) is the\nCB-to-SW bootstrap capacitor."
		(exclude_from_sim no)
		(at 156.21 90.5 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "d16883a9-0117-4931-900e-b0ea8a3c6885")
	)
