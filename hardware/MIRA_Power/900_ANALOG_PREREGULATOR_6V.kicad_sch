	)
	(text "BUS24 feeds U901 (LMR51610XDBVR). CMD_ANA drives Q901 as an active-high\nsource follower. R901 (100 kOhm) pulls EN_ANA low when Q901 is off. The\ncommand must not float; verify its high-level margin."
		(exclude_from_sim no)
		(at 156.21 65.3 0)
