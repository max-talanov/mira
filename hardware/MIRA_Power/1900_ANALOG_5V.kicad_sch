	(text "FB senses ANA5_RAW before R1905.\n50 mV/A shunt drop is uncompensated."
		(exclude_from_sim no)
		(at 98 81.2 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "0cf8b6a2-e4c6-4226-98cf-38b5d3346e85")
	)
	(text "1900_ANALOG_5V"
		(exclude_from_sim no)
		(at 20.32 19.05 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "11089723-1630-490a-acb6-5bd8305d0de3")
	)
	(text "CMD_ANA5 drives Q1901.\nR1901 pulls EN_ANA5 low.\nEnable after ANA6 is stable."
		(exclude_from_sim no)
		(at 73 40 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "17cf8608-9f4c-454c-aae0-59bff9932cfa")
	)
	(text "PGR_ANA5 is valid only while ANA6 is powered."
		(exclude_from_sim no)
		(at 23 151 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "19b4ee34-b5c8-405d-ae2b-e0315bd0aea1")
	)
	(text "Output and protection"
		(exclude_from_sim no)
		(at 156.21 136.2 0)
		(effects
			(font
				(size 1.9 1.9)
				(thickness 0.18)
				(bold yes)
