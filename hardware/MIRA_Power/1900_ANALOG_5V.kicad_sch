	)
	(text "Conversion and filtering"
		(exclude_from_sim no)
		(at 156.21 85.7 0)
		(effects
			(font
				(size 1.9 1.9)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "350e5cfd-943a-4c12-a126-2b4ec0bd4b88")
	)
	(text "C1901 and C1903 (47 uF each) bypass the input and regulated output. C1902\n(100 nF) at NR/SS filters reference noise and controls the ramp. SS_CTRL is\ngrounded, giving about 13 ms nominal soft start. C1904 (10 nF), from OUT to\nFB, improves noise and ripple rejection."
		(exclude_from_sim no)
		(at 156.21 90.5 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "46600fd1-e60e-4503-886b-1df4ed37237d")
	)
	(text "Purpose and role"
		(exclude_from_sim no)
		(at 156.21 40.64 0)
		(effects
			(font
				(size 1.9 1.9)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "506ee955-25cf-4398-9b6c-43eb63eab5eb")
	)
	(text "ANA6 -> ANA5 (5.000 V raw)\nNR/SS controls the startup ramp."
		(exclude_from_sim no)
		(at 20.32 87.2 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "57449483-7097-4b7b-8601-f9345e312f67")
	)
	(text "R1903 (10.5 kOhm) and R1904 (2.00 kOhm) sense ANA5_RAW. V(ANA5_RAW) = 0.8 V x\n(1 + R1903 / R1904) = 5.00 V. Increasing R1903 raises the voltage; increasing\nR1904 lowers it. For another setpoint, use R1903 = R1904 x (VOUT / 0.8 V -\n1)."
		(exclude_from_sim no)
		(at 156.21 116 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "5b6cd62b-635e-4979-83ef-47a795c2ff13")
	)
	(text "Low-noise regulation"
		(exclude_from_sim no)
