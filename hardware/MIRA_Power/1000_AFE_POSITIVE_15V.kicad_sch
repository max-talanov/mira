		)
		(uuid "4ea3aa59-54bd-4097-a9a6-1fc0c9f4f874")
	)
	(text "BUS24 feeds U1001 (LMR51610XDBVR). CMD_P15 drives Q1001 as an active-high\nsource follower. R1001 (100 kOhm) pulls EN_P15 low when Q1001 is off. The\ncommand must not float; verify its high-level margin."
		(exclude_from_sim no)
		(at 156.21 65.3 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
