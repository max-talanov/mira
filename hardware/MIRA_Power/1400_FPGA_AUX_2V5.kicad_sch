			)
			(justify left top)
		)
		(uuid "3a070007-8c99-4e31-9942-87fdd533fcfe")
	)
	(text "FPGA5V5 -> AUX25_RAW; L1401 + C1404 filter the output.\nVOS and feedback sense RAW before R1405."
		(exclude_from_sim no)
		(at 22 81.2 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "51094be7-1217-4ec8-b9e0-b91312ee1714")
	)
	(text "FPGA auxiliary supply, 2.5 V"
		(exclude_from_sim no)
		(at 156.21 26.24 0)
