		)
		(uuid "6f16cd9b-1b58-4533-adfc-4fec83ca537e")
	)
	(text "CMD_AUX25 drives Q1401; R1401 pulls EN low."
		(exclude_from_sim no)
		(at 22 31.2 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "701da9e5-e842-4f87-a484-f895b332e7d7")
	)
	(text "L1401 (2.2 uH) and C1404 (47 uF nominal) filter the switched output. VOS\nsenses AUX25_RAW; FSW tied to RAW selects the approximately 1.25 MHz mode as\nRAW rises. Power-save operation is automatic at light load. C1401 (10 nF) on\nSS/TR gives an approximately 5 ms ramp."
		(exclude_from_sim no)
		(at 156.21 90.5 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "9361dfe3-d8f5-42a8-b5c4-cc1e3523427b")
	)
	(text "SHEET GUIDE / 1400_FPGA_AUX_2V5"
		(exclude_from_sim no)
		(at 156.21 19.24 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "9f5cf1ec-58be-486c-ba72-d559c33c8a7d")
	)
	(text "Output and protection"
		(exclude_from_sim no)
		(at 156.21 136.2 0)
		(effects
			(font
				(size 1.9 1.9)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "a0683d28-b6da-4753-8c98-fe05df7850e6")
	)
	(text "This converter supplies the 2.5 V auxiliary domain of MIRA's FPGA subsystem.\nKeeping it separate from AUX1V8 and IO3V3 allows domains with different\nvoltage requirements to be enabled and checked independently. CMD_AUX25 and\nPGR_AUX25 support startup sequencing and fault supervision."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "aaa76290-c8bc-47e1-b3bf-dd07ba106a07")
	)
	(text "1400_FPGA_AUX_2V5"
		(exclude_from_sim no)
		(at 20.32 19.05 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "b1c1f354-a69c-48ff-8c6d-820bcb20c0b3")
	)
	(text "R1403 (34 kOhm) and R1404 (16 kOhm) set the RAW voltage:\nV(AUX25_RAW)=0.8 V x (1+R1403/R1404) = 2.5 V.\nTo change it: R1403 = R1404 x (VRAW / 0.8 V - 1). Increasing R1403 raises the\nvoltage. DEF is grounded; the +5% margin is disabled."
		(exclude_from_sim no)
		(at 156.21 116 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "cf01e7dc-945d-46d3-8352-be520fe2af78")
	)
