(text "J4906 <-> J405 | ETHERNET" (at 154.94 231.14 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7405cf9d-3076-4190-9edc-80065aa7a5b8"))
(text "FPGA J4902 / J401:\nOdd 1..15: eight CORE force contacts.\n17: positive sense; route separately to FPGA.\n19,21: AUX1V8. 23,25: IO3V3.\nEvery even pin: GND.\n\nDDR VREF: keep quiet beside GND.\nVTT must source and sink near termination.\nPlace Power converters below their zones.\nCoordinate and height tolerances need checking." (at 292.1 218.44 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "68c9614c-a92d-4495-8150-5c9d6d08a01e"))
)
