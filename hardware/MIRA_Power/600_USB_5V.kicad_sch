	(text "BUS24 feeds U601 (LMR51610XDBVR). CMD_USB drives Q601 as an active-high\nsource follower. R601 (100 kOhm) pulls EN_USB low when Q601 is off. The\ncommand must not float; verify its high-level margin."
		(exclude_from_sim no)
		(at 156.21 65.3 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
