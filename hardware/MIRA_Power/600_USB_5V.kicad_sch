		)
		(uuid "45245406-0065-4f4e-a234-f279299841d8")
	)
	(text "U601 operates at 400 kHz with PFM at light load. L601 (33 uH) and C604/C605\n(47 uF each) filter USB_RAW. C601/C603 bypass the input; C602 (100 nF) is the\nCB-to-SW bootstrap capacitor."
		(exclude_from_sim no)
		(at 156.21 90.5 0)
		(effects
			(font
				(size 1.55 1.55)
