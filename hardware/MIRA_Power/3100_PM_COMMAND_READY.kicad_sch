	)
	(text "Any command going LOW deasserts ALL_COMMANDS_ON and removes one matrix-enable\ncondition. This output cannot confirm voltage, current or pulse quality;\nphysical rail status and the other hardware interlocks remain required. An\nintentionally disabled included rail also prevents the aggregate."
		(exclude_from_sim no)
		(at 156.21 136.88 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "63aa852b-4c09-49f1-8a28-44c0b90037d7")
	)
