	)
	(text "This is the second stage of MIRA's ANA6 -> ANA5 -> ANA3V3 supply chain.\nANA3V3 provides a low-noise 3.3 V class rail for analog acquisition and\nconversion circuits. Cascaded regulation reduces ripple before it reaches the\nmeasurement path; it remains distinct from the digital 3.3 V domains."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "d25ed976-46f5-4a1b-b5b9-a48119c43d0f")
	)
