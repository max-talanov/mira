	)
	(text "U2001 (TPS7A9101) takes power from ANA5. CMD_ANA33 drives Q2001; R2001 (100\nkOhm) pulls EN_ANA33 low when Q2001 is off. Enable this stage after ANA5 is\nstable. PGR_ANA33 is pulled to AON by R2002 (10 kOhm); qualify its status\nwith input availability."
		(exclude_from_sim no)
		(at 156.21 65.3 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "461f2749-9d35-48d8-b02d-37b50bca1f4f")
	)
	(text "R2003 (49.9 kOhm) and R2004 (16.0 kOhm) sense ANA33_RAW. V(ANA33_RAW) = 0.8 V\nx (1 + R2003 / R2004) = 3.295 V. Increasing R2003 raises the voltage;\nincreasing R2004 lowers it. For another setpoint, use R2003 = R2004 x (VOUT /\n0.8 V - 1)."
		(exclude_from_sim no)
		(at 156.21 116 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "4d758832-ec93-49b6-ab0a-b15f648f9311")
	)
	(text "ANA5 -> ANA3V3 (3.295 V raw)\nNR/SS controls the startup ramp."
		(exclude_from_sim no)
		(at 20.32 87.2 0)
		(effects
			(font
				(size 1.15 1.15)
