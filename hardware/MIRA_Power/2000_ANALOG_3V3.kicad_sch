			(justify left top)
		)
		(uuid "0c295fb8-3234-470b-9c1f-39bd91e28116")
	)
	(text "FB senses ANA33_RAW before R2005.\n50 mV/A shunt drop is uncompensated."
		(exclude_from_sim no)
		(at 98 81.2 0)
		(effects
