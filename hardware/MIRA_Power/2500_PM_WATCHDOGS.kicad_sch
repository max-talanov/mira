	(text "PM_WDI and HOST_WDI are heartbeat inputs.\nAON_RESET_N and HOST_RESET_N report supply / manual reset.\nPM_WDO_N and HOST_WDO_N report watchdog expiry.\nJ2501 and J2502 provide PM and host manual reset contacts."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "91c9a886-30c1-4f79-8f29-7ed41f762fce")
	)
	(text "SET1 is high and CWD is open on both supervisors.\nWatchdog timeout: 1.60 s nominal, 1.36 to 1.84 s specified.\nProvide falling WDI edges sooner than the minimum timeout.\nReset release delay and WDO low pulse are 200 ms nominal."
		(exclude_from_sim no)
		(at 156.21 114.02 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
