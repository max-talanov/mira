	)
	(text "D2501 combines AON_RESET_N and PM_WDO_N into PM_RESET_N.\nEither low signal resets U2401 through the common-anode diode.\nHost watchdog and reset signals remain separate on this sheet;\nthe hardware interlocks use them to qualify matrix operation."
		(exclude_from_sim no)
		(at 156.21 91.16 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
