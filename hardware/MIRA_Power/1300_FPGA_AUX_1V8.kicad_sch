		(uuid "17b2d756-d9b3-483b-a1b6-39477820e9c3")
	)
	(text "R1305 (0.02 Ohm) drops 20 mV/A outside feedback. At 3 A, AUX1V8 is about 1.74\nV. R1306 (10 kOhm) bleeds the output. PGR_AUX18 is open drain, pulled to AON\nby R1302 (10 kOhm); use its RAW status only with FPGA5V5 present. The IC\nsupports up to 3 A, subject to thermal and shared-input limits. Current and\nthermal protection are internal."
		(exclude_from_sim no)
		(at 156.21 141 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "200c991f-495e-445a-9f99-ed7d9c16f32a")
	)
	(text "1300_FPGA_AUX_1V8"
		(exclude_from_sim no)
		(at 20.32 19.05 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "20fac0c5-addc-461f-a0f7-c3657943bfe0")
	)
	(text "FPGA auxiliary supply, 1.8 V"
		(exclude_from_sim no)
		(at 156.21 26.24 0)
		(effects
