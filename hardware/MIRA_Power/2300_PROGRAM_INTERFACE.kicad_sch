	)
	(text "PROG_P15 and PROG_N15 are generated and enabled on the upstream\nprogramming-switch sheets. This interface contains no local enable logic.\nJ2301 exports pin 1 = PROG_P15, pin 2 = GND, pin 3 = PROG_N15. The actual\nvoltage follows the upstream sources, switches and load."
		(exclude_from_sim no)
		(at 156.21 65.3 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "df047b32-cf6e-4af4-a1aa-2f76ee81b2cd")
	)
	(text "Purpose and role"
		(exclude_from_sim no)
		(at 156.21 40.64 0)
		(effects
			(font
				(size 1.9 1.9)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "f52b21eb-bec8-4cfa-bd06-585f34d6a4ed")
	)
	(text "This sheet brings MIRA's switched positive and negative programming rails to\nJ2301 and provides a scaled monitor of the positive output. It links the\nprogramming power switches to the matrix-drive hardware, allowing the power\ncontroller to check rail availability before a programming operation."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "f83a060d-4a4e-471c-af96-5f06fff49219")
	)
