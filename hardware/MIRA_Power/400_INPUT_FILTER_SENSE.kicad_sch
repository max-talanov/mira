	(text "SHEET GUIDE / 400_INPUT_FILTER_SENSE"
		(exclude_from_sim no)
		(at 154.86 19.24 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.18)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "042ffc95-5b31-42ca-8fd6-27e9a7af2082")
	)
	(text "R401 (20 mOhm / 1 W) carries the current delivered to BUS24.\nIts voltage drop is proportional to current: 20 mV per ampere.\nCurrent is calculated as I = (BUS24_PRE_SHUNT - BUS24) / 0.02 Ohm.\nAt 3.5 A, the drop is 70 mV and dissipation is approximately 0.245 W.\nIncreasing R401 increases measurement sensitivity, voltage drop and heat.\nThe current-measurement circuitry connects elsewhere in the project."
		(exclude_from_sim no)
		(at 154.94 68.58 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "07dd7d24-fde7-4985-9134-701e72985310")
	)
	(text "EFUSE_OUT feeds L401, a ferrite bead rated 120 Ohm at 100 MHz / 6 A.\nL401 attenuates high-frequency noise; its stated impedance is not its\nDC resistance. C401 (100 uF), C402 (1 uF) and C403 (100 nF) provide local\nenergy storage and bypass noise to GND. BUS24_PRE_SHUNT is the filtered\nsupply before R401; BUS24 is the supply after R401."
		(exclude_from_sim no)
		(at 154.86 45.446 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "1be3f971-00e3-4120-ba86-7063d7e91e69")
	)
	(text "Power path and filtering"
		(exclude_from_sim no)
		(at 154.86 40.426 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "396e4b25-5d79-41f7-913c-0660018cecfa")
	)
	(text "R402 (10 kOhm) limits current through the green LED D401. The LED indicates\nvoltage on BUS24, downstream of the shunt. At 24 V and approximately 2 V\nLED forward voltage, LED current is 2.2 mA.\n\nR403 and R404 (100 kOhm each) form a 200 kOhm discharge path from BUS24\nto GND. They draw 120 uA at 24 V and slowly discharge the connected\ncapacitance after power removal. Reducing their resistance accelerates\ndischarge and increases continuous power consumption."
		(exclude_from_sim no)
		(at 154.94 95.25 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "4ed8b332-59e3-4562-a043-854a36d582e3")
	)
	(text "24 V Bus Filtering and Current Sensing"
		(exclude_from_sim no)
		(at 154.86 26.24 0)
		(effects
			(font
				(size 2.6 2.6)
				(thickness 0.18)
				(bold yes)
				(color 25 47 72 1)
			)
			(justify left top)
		)
		(uuid "4fd8f011-c2a6-45c3-a58a-f3948d2978a2")
	)
	(text "Current-sense shunt"
		(exclude_from_sim no)
		(at 154.94 63.56 0)
