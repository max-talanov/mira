	(text "SHEET GUIDE / 500_AON_3V3_BUCK"
		(exclude_from_sim no)
		(at 156.21 19.24 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "f388bb6a-6b51-4ee2-8a65-e721addcacb2")
	)
	(text "Generates AON for control and protection circuitry. AON is available while\nBUS24 is present, even when command-controlled supplies are disabled.\nRemoving BUS24 also removes AON."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
