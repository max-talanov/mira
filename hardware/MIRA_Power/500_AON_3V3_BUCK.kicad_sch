			)
			(justify left top)
		)
		(uuid "27c80cb4-1452-44af-a759-8914d069359b")
	)
	(text "Always-on control supply, 3.28 V before shunt"
		(exclude_from_sim no)
		(at 156.21 26.24 0)
		(effects
			(font
				(size 2.35 2.35)
				(thickness 0.18)
				(bold yes)
				(color 25 47 72 1)
			)
			(justify left top)
		)
		(uuid "2b1b968a-1168-488b-b317-d5c8b2600d9c")
	)
	(text "Input and enable"
		(exclude_from_sim no)
		(at 156.21 60.5 0)
		(effects
			(font
				(size 1.9 1.9)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "4fd25a1c-7f8e-47e5-b500-5a5b280ace5c")
	)
	(text "U501 operates at 400 kHz with PFM at light load. L501 (33 uH) and C504/C505\n(47 uF each) filter AON_RAW. C502 (100 nF) is the CB-to-SW bootstrap\ncapacitor."
		(exclude_from_sim no)
		(at 156.21 90.5 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "5049b33d-16a9-4a19-ba02-43a52c0847c5")
	)
	(text "R503 (0.1 Ohm) causes a 100 mV/A drop: AON is about 3.18 V at 1 A. Feedback\nis before the shunt. U501 is a 1 A IC with internal current, short-circuit\nand thermal protection. D501 indicates rail presence; R503 does not set the\ncurrent limit."
		(exclude_from_sim no)
		(at 156.21 141 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "52aeff0e-366e-4ffd-8813-25a30fb1f706")
	)
	(text "Purpose and role"
		(exclude_from_sim no)
		(at 156.21 40.64 0)
		(effects
			(font
				(size 1.9 1.9)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "77e148d7-51c7-4308-8f1b-4cf28e9a066d")
	)
	(text "R501/R502: 3.28 V before R503.\nR503 causes a 100 mV/A drop."
		(exclude_from_sim no)
		(at 88 66.2 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "940260d4-af74-4e96-9548-cba3c3fb827d")
	)
	(text "BUS24 feeds U501 (LMR51610XDBVR) VIN and EN directly. No separate enable\ncommand is required. C501 (100 nF) and C503 (4.7 uF) bypass the input."
		(exclude_from_sim no)
		(at 156.21 65.3 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "945321a2-13e9-4d91-9776-6f627e49640c")
	)
	(text "Starts automatically while BUS24 is present.\nU501 operates at 400 kHz; PFM at light load."
		(exclude_from_sim no)
		(at 23 34.2 0)
		(effects
			(font
				(size 1.15 1.15)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "99241a34-e520-42bd-989a-028ff592dae7")
	)
	(text "R501 (62 kOhm) and R502 (20 kOhm) set AON_RAW:\nVRAW = 0.8 V x (1 + R501/R502) = 3.28 V.\nTo change the voltage: R501 = R502 x (VRAW/0.8 V - 1). Increasing the upper\nresistor raises VRAW."
		(exclude_from_sim no)
		(at 156.21 116 0)
		(effects
			(font
				(size 1.55 1.55)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "a2e09d7b-6103-4707-b2e3-e792b0b9baec")
	)
	(text "Output and protection"
		(exclude_from_sim no)
		(at 156.21 136.2 0)
		(effects
