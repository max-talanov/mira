	)
	(text "Control logic"
		(exclude_from_sim no)
		(at 156.21 86.36 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "c14e3d7b-2240-428b-ab9c-0b80aa276ca6")
	)
	(text "Global inputs cover input power, AON reset, PM watchdog/reset,\novercurrent and the global stop. Matrix inputs add rail/command\nreadiness, host watchdog/reset and the matrix stop. J2603 exports\nMATRIX_PERMIT, its inverse MATRIX_KILL_H, AON and GND."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "c7ef509c-1359-43ec-acda-5cefe00923cc")
	)
