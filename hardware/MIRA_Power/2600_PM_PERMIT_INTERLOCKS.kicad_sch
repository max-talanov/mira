				(size 2.05 2.05)
				(thickness 0.18)
				(bold yes)
				(color 25 47 72 1)
			)
			(justify left top)
		)
		(uuid "6ba9c0cd-ac3c-41e7-bab2-87f444247ccf")
	)
	(text "SHEET GUIDE / 2600_PM_PERMIT_INTERLOCKS"
		(exclude_from_sim no)
		(at 156.21 19.24 0)
		(effects
