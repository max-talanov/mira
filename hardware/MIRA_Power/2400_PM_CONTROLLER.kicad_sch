	(text "PWR_ARM_PULSE and MATRIX_ARM_PULSE clock the permit latches.\nGLOBAL_PWR_PERMIT and MATRIX_PERMIT are status inputs.\nPWR_KILL_GPIO and MATRIX_KILL_GPIO request hardware shutdown.\nPM_UART_TX / RX use USART3 on PD8 / PD9, alternate function 0."
		(exclude_from_sim no)
		(at 156.21 91.16 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "318a5860-943b-46ce-8706-243d746d725d")
	)
	(text "Requests startup; hardware latches retain the permits.\nMatrix timing and neural computation are handled elsewhere."
		(exclude_from_sim no)
		(at 20.32 32.385 0)
		(effects
			(font
				(size 0.82 0.82)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "3805979b-04b1-4883-80ac-20ed6ac52d25")
	)
	(text "Read GLOBAL_PWR_PERMIT and MATRIX_PERMIT as inputs.\nInitialize EN_REQ_* safely before applying either arm pulse."
		(exclude_from_sim no)
		(at 20.32 140.335 0)
		(effects
			(font
				(size 0.85 0.85)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "614573d3-b43c-4abc-bf47-a9957ac8aa86")
	)
	(text "Power management controller"
		(exclude_from_sim no)
		(at 156.21 26.24 0)
		(effects
			(font
				(size 2.05 2.05)
				(thickness 0.18)
				(bold yes)
				(color 25 47 72 1)
			)
			(justify left top)
		)
		(uuid "6cffae03-ccc0-43a6-80e0-3d38c1fbaa67")
	)
	(text "Purpose and role"
		(exclude_from_sim no)
		(at 156.21 40.64 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "7b768da4-34fc-45c9-84e3-f1c85d2ace79")
	)
	(text "AON is also the ADC reference.\nKeep the internal VREFBUF output disabled."
		(exclude_from_sim no)
		(at 20.32 83.82 0)
		(effects
			(font
				(size 0.82 0.82)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "9a3d5962-36f8-4176-9598-49aaa33bdff4")
	)
	(text "Inputs and outputs"
		(exclude_from_sim no)
		(at 156.21 63.5 0)
		(effects
			(font
				(size 1.8 1.8)
				(thickness 0.18)
				(bold yes)
				(color 0 100 110 1)
			)
			(justify left top)
		)
		(uuid "9d6fc2bd-7847-4d4f-b564-637cc955c16d")
	)
	(text "AON-powered rail sequencer"
		(exclude_from_sim no)
		(at 20.32 28.575 0)
		(effects
			(font
				(size 0.95 0.95)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "9e357cba-d88d-435d-a2ce-9ae206410566")
	)
	(text "The startup order and rail settling delays are set in firmware.\nService PM_WDI before the external watchdog can time out.\nUse internal clocking: PF0 is assigned to EN_REQ_USB.\nKeep NRST and SWD active; keep the VREFBUF output disabled."
		(exclude_from_sim no)
		(at 156.21 114.02 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "ac3c5e55-e811-4362-8574-ccfd5e319761")
	)
	(text "EN_REQ_* requests the individual converter enables.\nPG_*, PGR_* and ALL_RAILS_PG report supply readiness.\nPA0 / PA1 / PA2 / PA3 measure current, voltage, VTT and PROG_P15.\nMUX_A0..A3 select telemetry channels; MUX_DISABLE gates the mux."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "b1ee1dca-2779-42e8-99c9-9fc4b7da67ad")
	)
	(text "2400_PM_CONTROLLER"
		(exclude_from_sim no)
		(at 20.32 19.05 0)
		(effects
			(font
				(size 1.25 1.25)
				(thickness 0.15)
				(color 86 96 108 1)
			)
			(justify left top)
		)
		(uuid "c02835e2-438d-4e8b-b155-51e4d52d5e99")
	)
	(text "AON supply and local decoupling"
		(exclude_from_sim no)
		(at 20.32 54.61 0)
		(effects
			(font
				(size 0.85 0.85)
				(thickness 0.15)
				(color 0 70 190 1)
			)
			(justify left top)
		)
		(uuid "d2e9f65b-ff46-4e65-bb28-efa8bc5fb213")
	)
	(text "U2401 is the dedicated STM32G0B1 power sequencer for MIRA.\nIt remains active on AON while the switched rails are disabled,\nso it can coordinate startup, monitor supplies and handle faults.\nThe FPGA controls matrix timing; STM32H745 runs neuron models."
		(exclude_from_sim no)
		(at 156.21 45.44 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "d5dab6a8-5733-4d78-b864-6b15a872fc2d")
	)
