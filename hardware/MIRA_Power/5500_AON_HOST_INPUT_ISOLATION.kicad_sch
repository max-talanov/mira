	(text "RESET RECEIVE PATH\nU5501 feeds U2602.10 only.\nHost NRST and the open-drain watchdog\nremain on the original HOST_RESET_N net.\nR5501 defines an undriven input LOW.\nR5502 defines an undriven output LOW."
		(at 175.26 36.83 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "89c5f4da-5e94-4f6e-98d6-8926ad93f00a")
	)
	(text "UART RECEIVE PATH\nR3305 remains the 1 kOhm input resistor.\nR3306 holds HOST_UART_TX_RAW LOW.\nU5502 drives PM_UART_RX; R5503 pulls down.\nC5501/C5502: place at each VCC pin.\nReserve +2 mA and +0.2 uF on AON."
		(at 175.26 95.25 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "8a94913c-47de-4efd-8c88-e9ea0eb63911")
	)
	(text "74LVC1G17GV,125: Ioff; input 0..5.5 V, including VCC=0. Common GND required.\nNo claim of valid logic below minimum VCC. Existing AON supervisor/clear still governs startup.\nANALOG REMEDIATION: see sheets 5600-6100 and Control 2300-3300; docs/pcb-preparation/signal-remediation."
		(at 20.32 170.18 0)
		(effects
			(font
				(size 1.0 1.0)
			)
			(justify left top)
		)
		(uuid "536c92b3-1ef1-41ca-bd95-aab0f778b98b")
	)
	(embedded_fonts no)






