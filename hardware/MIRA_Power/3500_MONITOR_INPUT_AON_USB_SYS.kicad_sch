	)
	(text "INA301 ALERT outputs share OC_OK_N: a low level signals an overcurrent. RESET is\ngrounded, selecting transparent mode; fault memory is on the interlock sheet.\nU3501 provides input-current telemetry without a hardware alert."
		(exclude_from_sim no)
		(at 156.21 91.16 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
