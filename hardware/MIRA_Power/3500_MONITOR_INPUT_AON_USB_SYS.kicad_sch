	)
	(text "U3501 senses BUS24_PRE_SHUNT to BUS24. U3502-U3504 sense AON_RAW/AON,\nUSB_RAW/USB5 and SYS_RAW/SYS3V3. MON_I_* and MON_V_* feed the telemetry\nmultiplexers; MON_V_USB also feeds the analog power-good comparator. All\nmonitors use AON and GND."
		(exclude_from_sim no)
		(at 156.21 68.3 0)
		(effects
			(font
				(size 1.45 1.45)
				(thickness 0.15)
				(color 33 43 55 1)
			)
			(justify left top)
		)
		(uuid "ad253d45-1b53-460d-b0c4-f34eb90d223c")
	)
	(text "Protection and fault response"
		(exclude_from_sim no)
